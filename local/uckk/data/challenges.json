/**
 * Render one challenge card.
 *
 * @param stdClass $challenge Challenge record.
 * @return string
 */
function local_uckk_challenges_render_card(stdClass $challenge): string {
    $output = html_writer::start_tag('article', [
        'class' => 'local-uckk-public-card local-uckk-public-card--challenge local-uckk-public-card--status-' .
            clean_param($challenge->status, PARAM_ALPHANUMEXT),
    ]);

    $output .= html_writer::div(
        s(local_uckk_challenges_get_status_label($challenge->status)),
        'local-uckk-public-card__eyebrow'
    );

    $output .= html_writer::tag('h3', s($challenge->title), [
        'class' => 'local-uckk-public-card__title',
    ]);

    $output .= html_writer::div(s($challenge->kind), 'local-uckk-public-meta local-uckk-public-meta--kind');

    $output .= html_writer::tag('p', s($challenge->summary), [
        'class' => 'local-uckk-public-card__body',
    ]);

    if (!empty($challenge->proofs)) {
        $output .= html_writer::div('Preuves attendues', 'local-uckk-public-meta__label');
        $output .= html_writer::start_tag('ul', ['class' => 'local-uckk-public-list local-uckk-public-list--proofs']);

        foreach ($challenge->proofs as $proof) {
            $output .= html_writer::tag('li', s($proof));
        }

        $output .= html_writer::end_tag('ul');
    }

    $output .= html_writer::start_div('local-uckk-public-meta');
    $output .= local_uckk_challenges_render_meta('Assemblée', $challenge->assembly);
    $output .= local_uckk_challenges_render_meta('Archive', $challenge->archive);
    $output .= html_writer::end_div();

    if (!empty($challenge->url)) {
        $output .= html_writer::div(
            html_writer::link(
                new moodle_url($challenge->url),
                'Ouvrir le défi',
                ['class' => 'btn btn-outline-primary btn-sm local-uckk-public-card__action']
            ),
            'local-uckk-public-card__footer'
        );
    }

    $output .= html_writer::end_tag('article');

    return $output;
}

/**
 * Render challenge metadata.
 *
 * @param string $label Label.
 * @param string $value Value.
 * @return string
 */
function local_uckk_challenges_render_meta(string $label, string $value): string {
    if ($value === '') {
        return '';
    }

    $output = html_writer::start_tag('span', ['class' => 'local-uckk-public-meta__item']);
    $output .= html_writer::span(s($label) . ' : ', 'local-uckk-public-meta__label');
    $output .= html_writer::span(s($value), 'local-uckk-public-meta__value');
    $output .= html_writer::end_tag('span');

    return $output;
}

/**
 * Return category URL for challenge space if it exists.
 *
 * @return moodle_url|null
 */
function local_uckk_challenges_get_category_url(): ?moodle_url {
    global $DB;

    $category = $DB->get_record(
        'course_categories',
        ['idnumber' => 'UCKK-CAT-90-DEFIS-KING-KLOWN'],
        'id',
        IGNORE_MISSING
    );

    if (!$category) {
        return null;
    }

    return new moodle_url('/course/index.php', ['categoryid' => $category->id]);
}

/**
 * Normalise challenge status.
 *
 * @param string $status Raw status.
 * @return string
 */
function local_uckk_challenges_normalise_status(string $status): string {
    $status = clean_param($status, PARAM_ALPHANUMEXT);

    $aliases = [
        '' => 'open',
        'active' => 'open',
        'published' => 'open',
        'review' => 'underreview',
        'under_review' => 'underreview',
        'under-review' => 'underreview',
        'closed' => 'archived',
    ];

    $status = $aliases[$status] ?? $status;

    $allowed = ['open', 'underreview', 'archived', 'all'];

    return in_array($status, $allowed, true) ? $status : 'open';
}

/**
 * Return public status label.
 *
 * @param string $status Status.
 * @return string
 */
function local_uckk_challenges_get_status_label(string $status): string {
    $labels = [
        'open' => 'Ouvert',
        'underreview' => 'En révision',
        'archived' => 'Archivé',
        'all' => 'Tous',
    ];

    return $labels[$status] ?? $status;
}
