        'challenges' => [
            'label' => local_uckk_challenges_string('public_nav_challenges', 'Défis'),
            'url' => new moodle_url('/local/uckk/challenges.php'),
        ],
        'assemblies' => [
            'label' => local_uckk_challenges_string('public_nav_assemblies', 'Assemblées'),
            'url' => new moodle_url('/local/uckk/assemblies.php'),
        ],
        'integrity' => [
            'label' => local_uckk_challenges_string('public_nav_integrity', 'Intégrité'),
            'url' => new moodle_url('/local/uckk/integrity.php'),
        ],
        'archives' => [
            'label' => local_uckk_challenges_string('public_nav_archives', 'Archives'),
            'url' => new moodle_url('/local/uckk/archives.php'),
        ],
        'news' => [
            'label' => local_uckk_challenges_string('public_nav_news', 'Actualités'),
            'url' => new moodle_url('/local/uckk/news.php'),
        ],
        'contact' => [
            'label' => local_uckk_challenges_string('public_nav_contact', 'Contact'),
            'url' => new moodle_url('/local/uckk/contact.php'),
        ],
    ];

    $output = html_writer::start_tag('nav', [
        'class' => 'local-uckk-public-nav',
        'aria-label' => local_uckk_challenges_string('public_nav_label', 'Navigation publique UCKK'),
    ]);

    $output .= html_writer::start_tag('ul', ['class' => 'local-uckk-public-nav__list']);

    foreach ($items as $key => $item) {
        $isactive = $key === $active;

        $output .= html_writer::start_tag('li', ['class' => 'local-uckk-public-nav__item']);
        $output .= html_writer::link(
