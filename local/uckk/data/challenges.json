/**
 * Return challenges from local JSON data or fallback examples.
 *
 * @param string $status Status filter.
 * @return array<int, stdClass>
 */
function local_uckk_challenges_get_challenges(string $status = 'open'): array {
    $items = local_uckk_challenges_load_json_items();

    if (empty($items)) {
        $items = local_uckk_challenges_get_fallback_items();
    }

    $items = array_map(static function(array $item): stdClass {
        $challenge = new stdClass();

        $challenge->title = clean_text($item['title'] ?? '');
        $challenge->status = local_uckk_challenges_normalise_status($item['status'] ?? 'open');
        $challenge->kind = clean_text($item['kind'] ?? 'Défi public');
        $challenge->summary = clean_text($item['summary'] ?? '');
        $challenge->proofs = [];

        if (!empty($item['proofs']) && is_array($item['proofs'])) {
            foreach ($item['proofs'] as $proof) {
                $challenge->proofs[] = clean_text((string)$proof);
            }
        }

        $challenge->assembly = clean_text($item['assembly'] ?? 'Assemblée des Défis');
        $challenge->archive = clean_text($item['archive'] ?? 'Archive publique à constituer');
        $challenge->url = clean_text($item['url'] ?? '');

        return $challenge;
    }, $items);

    if ($status !== 'all') {
        $items = array_values(array_filter($items, static function(stdClass $challenge) use ($status): bool {
            return $challenge->status === $status;
        }));
    }

    return $items;
}

/**
 * Load challenge items from local/uckk/data/challenges.json.
 *
 * Expected JSON:
 * {
 *   "items": [
 *     {
 *       "title": "...",
 *       "status": "open",
 *       "kind": "...",
 *       "summary": "...",
 *       "proofs": ["...", "..."],
 *       "assembly": "...",
 *       "archive": "...",
 *       "url": "..."
 *     }
 *   ]
 * }
 *
 * @return array<int, array<string, mixed>>
 */
function local_uckk_challenges_load_json_items(): array {
    $path = __DIR__ . '/data/challenges.json';

    if (!is_readable($path)) {
        return [];
    }

    $raw = file_get_contents($path);

    if ($raw === false || trim($raw) === '') {
        return [];
    }

    $decoded = json_decode($raw, true);

    if (!is_array($decoded)) {
        debugging('local_uckk: Invalid challenges.json.', DEBUG_DEVELOPER);
        return [];
    }

    if (isset($decoded['items']) && is_array($decoded['items'])) {
        return $decoded['items'];
    }

    if (array_is_list($decoded)) {
        return $decoded;
    }

    return [];
}

