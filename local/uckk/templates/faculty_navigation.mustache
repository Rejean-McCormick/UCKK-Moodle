    @template local_uckk/faculty_navigation

    Public faculty navigation partial.

    Context:
    {
        "navigation": [
            {
                "label": "",
                "target": ""
            }
        ]
    }

    This template must not:
    - query Moodle data;
    - decide permissions;
    - create fallback navigation;
    - validate anchors;
    - expose private user data;
    - expose completion, grades, notes, participants, enrolments, or submissions;
    - introduce undocumented variables.
}}

<nav
    class="local-uckk-public-nav local-uckk-faculty-nav"
    data-region="local-uckk-faculty-navigation"
    aria-label="{{#str}} navigation, local_uckk {{/str}}"
>
    <ul class="local-uckk-public-nav__list local-uckk-faculty-nav__list">
        {{#navigation}}
            <li class="local-uckk-public-nav__item local-uckk-faculty-nav__item">
                <a
                    class="local-uckk-public-nav__link local-uckk-faculty-nav__link"
                    href="{{target}}"
                >
                    {{label}}
                </a>
            </li>
        {{/navigation}}
    </ul>
</nav>