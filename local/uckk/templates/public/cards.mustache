{{!
    @template local_uckk/public/cards

    Public card section for local_uckk institutional pages.

    This template renders the generic public cards block extracted from
    local_uckk/public_page.

    It is intentionally render-only.

    Context variables required for this template:
    * uniqid - Unique page DOM id prefix.
    * cardsheading - Visible heading for the card section.
    * cards - List of public cards.

    Context variables for each card:
    * classes - Safe CSS classes generated by PHP.
    * eyebrow - Optional small label.
    * title - Optional card title.
    * body - Optional card body.
    * url - Optional card URL.
    * actionlabel - Optional action label.
    * hasaction - Whether to render the action link.
}}

<section
    class="local-uckk-public-section local-uckk-public-section--cards"
    aria-labelledby="{{uniqid}}-cards-title"
    data-region="local-uckk-public-cards"
>
    <h2 id="{{uniqid}}-cards-title" class="local-uckk-public-section__title">
        <span class="local-uckk-public-section__title-text">
            {{cardsheading}}
        </span>
    </h2>

    <div class="local-uckk-public-card-grid">
        {{#cards}}
            <article class="{{classes}}">
                <div class="local-uckk-public-card__content">
                    {{#eyebrow}}
                        <p class="local-uckk-public-card__eyebrow">
                            {{eyebrow}}
                        </p>
                    {{/eyebrow}}

                    {{#title}}
                        <h3 class="local-uckk-public-card__title">
                            {{#url}}
                                <a href="{{url}}">
                                    {{title}}
                                </a>
                            {{/url}}
                            {{^url}}
                                {{title}}
                            {{/url}}
                        </h3>
                    {{/title}}

                    {{#body}}
                        <p class="local-uckk-public-card__body">
                            {{body}}
                        </p>
                    {{/body}}
                </div>

                {{#hasaction}}
                    <p class="local-uckk-public-card__action">
                        <a class="local-uckk-public-card__action-link" href="{{url}}">
                            {{actionlabel}}
                        </a>
                    </p>
                {{/hasaction}}
            </article>
        {{/cards}}
    </div>
</section>