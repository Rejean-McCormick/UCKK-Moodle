{{!
    @template local_uckk/public_page

    Public institutional page shell for local_uckk.

    This template is the single visual contract for the public UCKK pages:
    Accueil, À propos, Voies, Cours, Défis, Assemblées, Intégrité,
    Archives, Médiathèque, Actualités and Contact.

    It is intentionally render-only.

    It must not:
    - query or mutate the database;
    - decide visibility or permissions;
    - validate challenges, archives or assemblies;
    - assign roles, badges, levels or parchments;
    - publish institutional recognition;
    - decide integrity cases;
    - create authoritative canon.

    Official context contract:
    {
        "uniqid": "local-uckk-public-page-abc123",
        "slug": "about",
        "component": "local_uckk",
        "pagetype": "institutional",
        "ispublic": true,
        "classes": "local-uckk local-uckk-public-page local-uckk-public-page--about local-uckk-public-page--layout-wide local-uckk-public-page--with-aside",
        "layout": "wide",
        "navigationlayout": "singleline",
        "layoutclasses": "local-uckk-public-layout local-uckk-public-layout--wide",
        "shellclasses": "local-uckk-public-shell local-uckk-public-shell--wide",
        "bodyclasses": "local-uckk-public-body local-uckk-public-body--wide local-uckk-public-body--with-aside",
        "mainclasses": "local-uckk-public-main local-uckk-public-main--wide local-uckk-public-main--with-aside",
        "asideclasses": "local-uckk-public-aside local-uckk-public-aside--wide",
        "hasaside": true,

        "railclasses": "local-uckk-public-rail local-uckk-public-rail--wide",
        "headerclasses": "local-uckk-public-header local-uckk-public-header--wide",
        "heroclasses": "local-uckk-public-hero local-uckk-public-hero--wide local-uckk-public-hero--with-aside",
        "contentclasses": "local-uckk-public-content local-uckk-public-content--wide local-uckk-public-content--with-aside",
        "asideinnerclasses": "local-uckk-public-aside__inner local-uckk-public-aside__inner--wide",
        "typographyclasses": "local-uckk-public-typography local-uckk-public-typography--institutional",
        "sectiongridclasses": "local-uckk-public-section-grid local-uckk-public-section-grid--wide",
        "cardgridclasses": "local-uckk-public-card-grid local-uckk-public-card-grid--wide",
        "designversion": "2026-layout-v2",
        "fontstrategy": "libre-baskerville-primary-eb-garamond-accent",

        "eyebrow": "Cité-école expérimentale",
        "title": "Univers-Cité King Klown",
        "subtitle": "Campus Moodle public",
        "summary": "Présentation publique d’UCKK.",
        "hasnavigation": true,
        "navigationclasses": "local-uckk-public-nav local-uckk-public-nav--singleline",
        "navigation": [
            {
                "key": "home",
                "label": "Accueil",
                "url": "https://example.test/local/uckk/index.php",
                "active": true,
                "classes": "local-uckk-public-nav__link is-active",
                "itemclasses": "local-uckk-public-nav__item local-uckk-public-nav__item--active",
                "ariacurrent": "page",
                "hasariacurrent": true
            }
        ],

        "hasquicklinks": true,
        "quicklinks": [
            {
                "label": "Voies",
                "description": "Explorer les parcours UCKK.",
                "url": "https://example.test/local/uckk/programs.php",
                "hasdescription": true,
                "hasurl": true
            }
        ],

        "hassections": true,
        "sections": [
            {
                "eyebrow": "Repère",
                "title": "Pourquoi cette page existe",
                "body": "Clarifier le rôle public de la cité-école.",
                "hasitems": false,
                "hascards": false,
                "classes": "local-uckk-public-section"
            }
        ],

        "hascards": true,
        "cardsheading": "Repères publics",
        "cards": [
            {
                "title": "Défis King Klown",
                "body": "Épreuves publiques ou internes orientées vers preuves, apprentissage et archive.",
                "url": "https://example.test/local/uckk/challenges.php",
                "actionlabel": "Consulter",
                "hasaction": true
            }
        ],

        "has_mediatheque_explorer": true,
        "mediatheque_explorer_id": "local-uckk-mediatheque-explorer-abc123",
        "mediatheque_initial_state_json": "{\"cmid\":0,\"archiveid\":0,\"query\":\"\",\"filters\":{},\"page\":1,\"perpage\":12,\"sort\":\"relevance\"}",

        "hasmetadata": true,
        "metadata": [
            {
                "label": "Statut",
                "value": "Page publique"
            }
        ],

        "hascta": true,
        "cta": {
            "title": "Participer",
            "body": "Proposer une contribution, un défi, une correction ou une archive.",
            "url": "https://example.test/local/uckk/contact.php",
            "actionlabel": "Contacter UCKK",
            "label": "Contacter UCKK",
            "hasaction": true,
            "classes": "btn btn-primary local-uckk-public-cta__link"
        }
    }
}}

<div
    id="{{uniqid}}"
    class="{{classes}}"
    data-region="local-uckk-public-page"
    data-component="{{component}}"
    data-page-slug="{{slug}}"
    data-page-type="{{pagetype}}"
    data-layout="{{layout}}"
    data-navigation-layout="{{navigationlayout}}"
    data-has-aside="{{#hasaside}}true{{/hasaside}}{{^hasaside}}false{{/hasaside}}"
    {{#ispublic}}data-public="true"{{/ispublic}}
>
    <div class="local-uckk-public-shell" data-region="local-uckk-public-shell">
        {{#hasnavigation}}
            <nav
                class="{{navigationclasses}}"
                aria-label="Navigation publique UCKK"
                data-region="local-uckk-public-navigation"
            >
                <div class="local-uckk-public-nav__viewport">
                    <ul class="local-uckk-public-nav__list" role="list">
                        {{#navigation}}
                            <li class="{{itemclasses}}">
                                <a
                                    class="{{classes}}"
                                    href="{{url}}"
                                    data-nav-key="{{key}}"
                                    data-nav-active="{{#active}}true{{/active}}{{^active}}false{{/active}}"
                                    {{#hasariacurrent}}aria-current="{{ariacurrent}}"{{/hasariacurrent}}
                                >
                                    <span class="local-uckk-public-nav__label">
                                        {{label}}
                                    </span>
                                </a>
                            </li>
                        {{/navigation}}
                    </ul>
                </div>
            </nav>
        {{/hasnavigation}}

        <header
            class="local-uckk-public-hero"
            data-region="local-uckk-public-hero"
            aria-labelledby="{{uniqid}}-title"
        >
            <div class="local-uckk-public-hero__content">
                {{#eyebrow}}
                    <p class="local-uckk-public-eyebrow">
                        {{eyebrow}}
                    </p>
                {{/eyebrow}}

                <h1 id="{{uniqid}}-title" class="local-uckk-public-title">
                    {{title}}
                </h1>

                {{#subtitle}}
                    <p class="local-uckk-public-subtitle">
                        {{subtitle}}
                    </p>
                {{/subtitle}}

                {{#summary}}
                    <p class="local-uckk-public-summary">
                        {{summary}}
                    </p>
                {{/summary}}

            </div>
        </header>

        {{#hasquicklinks}}
            <section
                class="local-uckk-public-section local-uckk-public-section--quicklinks"
                aria-labelledby="{{uniqid}}-quicklinks-title"
                data-region="local-uckk-public-quicklinks"
            >
                <h2 id="{{uniqid}}-quicklinks-title" class="local-uckk-public-section__title">
                    <span class="local-uckk-public-section__title-text">
                        Repères rapides
                    </span>
                </h2>

                <div class="local-uckk-public-card-grid local-uckk-public-card-grid--quicklinks">
                    {{#quicklinks}}
                        <a class="local-uckk-public-card local-uckk-public-card--quicklink" href="{{url}}">
                            <span class="local-uckk-public-card__title">
                                {{label}}
                            </span>

                            {{#description}}
                                <span class="local-uckk-public-card__body">
                                    {{description}}
                                </span>
                            {{/description}}
                        </a>
                    {{/quicklinks}}
                </div>
            </section>
        {{/hasquicklinks}}

        <div class="{{bodyclasses}}" data-region="local-uckk-public-body">
            <main class="{{mainclasses}}" data-region="local-uckk-public-main">
                {{#hassections}}
                    {{#sections}}
                        <section
                            class="{{classes}}"
                            data-region="local-uckk-public-section"
                        >
                            {{#eyebrow}}
                                <p class="local-uckk-public-section__eyebrow">
                                    {{eyebrow}}
                                </p>
                            {{/eyebrow}}

                            {{#title}}
                                <h2 class="local-uckk-public-section__title">
                                    <span class="local-uckk-public-section__title-text">
                                        {{title}}
                                    </span>
                                </h2>
                            {{/title}}

                            {{#body}}
                                <p class="local-uckk-public-section__body">
                                    {{body}}
                                </p>
                            {{/body}}

                            {{#hasitems}}
                                <div class="local-uckk-public-card-grid local-uckk-public-section__items">
                                    {{#items}}
                                        <article class="{{classes}}">
                                            <div class="local-uckk-public-card__content">
                                                {{#eyebrow}}
                                                    <p class="local-uckk-public-card__eyebrow">
                                                        {{eyebrow}}
                                                    </p>
                                                {{/eyebrow}}

                                                {{#title}}
                                                    <h3 class="local-uckk-public-card__title">
                                                        {{#url}}
                                                            <a class="local-uckk-public-card__title-link" href="{{url}}">
                                                                {{title}}
                                                            </a>
                                                        {{/url}}
                                                        {{^url}}
                                                            {{title}}
                                                        {{/url}}
                                                    </h3>
                                                {{/title}}

                                                {{#body}}
                                                    <p class="local-uckk-public-card__body">
                                                        {{body}}
                                                    </p>
                                                {{/body}}
                                            </div>

                                            {{#hasaction}}
                                                <p class="local-uckk-public-card__action">
                                                    <a class="local-uckk-public-card__action-link" href="{{url}}">
                                                        {{actionlabel}}
                                                    </a>
                                                </p>
                                            {{/hasaction}}
                                        </article>
                                    {{/items}}
                                </div>
                            {{/hasitems}}
                        </section>
                    {{/sections}}
                {{/hassections}}

                {{#has_mediatheque_explorer}}
                    <section
                        class="local-uckk-public-section local-uckk-public-section--mediatheque local-uckk-mediatheque"
                        aria-labelledby="{{uniqid}}-mediatheque-title"
                        data-region="local-uckk-public-mediatheque"
                    >
                        <div class="local-uckk-mediatheque__header">
                            <p class="local-uckk-public-section__eyebrow">
                                Archives publiques
                            </p>

                            <h2 id="{{uniqid}}-mediatheque-title" class="local-uckk-public-section__title">
                                <span class="local-uckk-public-section__title-text">
                                    Explorateur Médiathèque
                                </span>
                            </h2>

                            <p class="local-uckk-public-section__body">
                                Rechercher dans les médias publics, collections, références externes et passages documentés.
                            </p>
                        </div>

                        <div
                            id="{{mediatheque_explorer_id}}"
                            class="local-uckk-mediatheque-explorer"
                            data-region="local-uckk-mediatheque-explorer"
                            data-method="mod_uckkarchive_search_mediatheque"
                            data-autoload="1"
                            data-initial-state="{{mediatheque_initial_state_json}}"
                        >
                            <form
                                class="local-uckk-mediatheque-search"
                                data-region="mediatheque-search-form"
                                action="/local/uckk/mediatheque.php"
                                method="get"
                            >
                                <div class="local-uckk-mediatheque-search__primary">
                                    <label class="local-uckk-mediatheque-search__label" for="{{mediatheque_explorer_id}}-q">
                                        Rechercher dans la médiathèque
                                    </label>

                                    <div class="local-uckk-mediatheque-search__row">
                                        <input
                                            id="{{mediatheque_explorer_id}}-q"
                                            class="local-uckk-mediatheque-search__input"
                                            type="search"
                                            name="q"
                                            data-live-search="1"
                                            autocomplete="off"
                                            placeholder="Rechercher dans la médiathèque"
                                        >

                                        <button class="local-uckk-mediatheque-search__submit" type="submit">
                                            Rechercher
                                        </button>

                                        <button
                                            class="local-uckk-mediatheque-search__reset"
                                            type="button"
                                            data-action="mediatheque-reset"
                                            data-keep-enabled="1"
                                        >
                                            Réinitialiser
                                        </button>
                                    </div>
                                </div>

                                <div class="local-uckk-mediatheque-filters" data-region="mediatheque-filters">
                                    <div class="local-uckk-mediatheque-filter">
                                        <label for="{{mediatheque_explorer_id}}-mediatype">
                                            Format
                                        </label>
                                        <select id="{{mediatheque_explorer_id}}-mediatype" name="mediatype">
                                            <option value="all">Tous les formats</option>
                                            <option value="video">Vidéo</option>
                                            <option value="audio">Audio</option>
                                            <option value="image">Image</option>
                                            <option value="pdf">PDF</option>
                                            <option value="document">Document</option>
                                            <option value="book">Livre</option>
                                            <option value="external_reference">Référence externe</option>
                                            <option value="other">Autre</option>
                                        </select>
                                    </div>

                                    <div class="local-uckk-mediatheque-filter">
                                        <label for="{{mediatheque_explorer_id}}-sort">
                                            Tri
                                        </label>
                                        <select id="{{mediatheque_explorer_id}}-sort" name="sort">
                                            <option value="relevance">Pertinence</option>
                                            <option value="newest">Plus récent</option>
                                            <option value="title">Titre</option>
                                            <option value="type">Type</option>
                                        </select>
                                    </div>

                                    <input type="hidden" name="type" value="all">
                                    <input type="hidden" name="collection" value="">
                                    <input type="hidden" name="tag" value="">
                                    <input type="hidden" name="source" value="">
                                    <input type="hidden" name="advisory" value="all">
                                    <input type="hidden" name="cultural" value="all">
                                    <input type="hidden" name="audience" value="all">
                                    <input type="hidden" name="lang" value="">
                                    <input type="hidden" name="validation" value="all">
                                    <input type="hidden" name="page" value="1">
                                    <input type="hidden" name="perpage" value="12">
                                </div>
                            </form>

                            <div class="local-uckk-mediatheque-statusbar">
                                <p class="local-uckk-mediatheque-status" data-region="mediatheque-status" aria-live="polite">
                                    Chargement de la médiathèque…
                                </p>

                                <p class="local-uckk-mediatheque-count">
                                    <span data-region="mediatheque-count">0</span>
                                    résultat(s)
                                </p>
                            </div>

                            <div
                                class="local-uckk-mediatheque-results"
                                data-region="mediatheque-results"
                                aria-live="polite"
                            ></div>

                            <div
                                class="local-uckk-mediatheque-empty"
                                data-region="mediatheque-empty"
                                hidden
                            >
                                Aucun média public ne correspond aux filtres.
                            </div>

                            <p class="local-uckk-mediatheque-pagination">
                                <button
                                    class="local-uckk-mediatheque-load-more"
                                    type="button"
                                    data-action="mediatheque-load-more"
                                    hidden
                                >
                                    Charger plus de résultats
                                </button>
                            </p>
                        </div>
                    </section>
                {{/has_mediatheque_explorer}}

                {{#hascards}}
                    <section
                        class="local-uckk-public-section local-uckk-public-section--cards"
                        aria-labelledby="{{uniqid}}-cards-title"
                        data-region="local-uckk-public-cards"
                    >
                        <h2 id="{{uniqid}}-cards-title" class="local-uckk-public-section__title">
                            <span class="local-uckk-public-section__title-text">
                                {{cardsheading}}
                            </span>
                        </h2>

                        <div class="local-uckk-public-card-grid">
                            {{#cards}}
                                <article class="{{classes}}">
                                    <div class="local-uckk-public-card__content">
                                        {{#eyebrow}}
                                            <p class="local-uckk-public-card__eyebrow">
                                                {{eyebrow}}
                                            </p>
                                        {{/eyebrow}}

                                        {{#title}}
                                            <h3 class="local-uckk-public-card__title">
                                                {{#url}}
                                                    <a href="{{url}}">
                                                        {{title}}
                                                    </a>
                                                {{/url}}
                                                {{^url}}
                                                    {{title}}
                                                {{/url}}
                                            </h3>
                                        {{/title}}

                                        {{#body}}
                                            <p class="local-uckk-public-card__body">
                                                {{body}}
                                            </p>
                                        {{/body}}
                                    </div>

                                    {{#hasaction}}
                                        <p class="local-uckk-public-card__action">
                                            <a class="local-uckk-public-card__action-link" href="{{url}}">
                                                {{actionlabel}}
                                            </a>
                                        </p>
                                    {{/hasaction}}
                                </article>
                            {{/cards}}
                        </div>
                    </section>
                {{/hascards}}
            </main>

            {{#hasaside}}
                <aside
                    class="{{asideclasses}}"
                    data-region="local-uckk-public-aside"
                    aria-label="Repères institutionnels"
                >
                    <div class="local-uckk-public-aside__inner">
                        {{#hasmetadata}}
                            <section
                                class="local-uckk-public-section local-uckk-public-section--metadata"
                                aria-labelledby="{{uniqid}}-metadata-title"
                            >
                                <h2 id="{{uniqid}}-metadata-title" class="local-uckk-public-section__title">
                                    <span class="local-uckk-public-section__title-text">
                                        Statut de la page
                                    </span>
                                </h2>

                                <dl class="local-uckk-public-meta">
                                    {{#metadata}}
                                        <div class="local-uckk-public-meta__item">
                                            <dt class="local-uckk-public-meta__label">
                                                {{label}}
                                            </dt>
                                            <dd class="local-uckk-public-meta__value">
                                                {{value}}
                                            </dd>
                                        </div>
                                    {{/metadata}}
                                </dl>
                            </section>
                        {{/hasmetadata}}

                        {{#hascta}}
                            {{#cta}}
                                <section class="local-uckk-public-cta">
                                    {{#title}}
                                        <h2 class="local-uckk-public-cta__title">
                                            {{title}}
                                        </h2>
                                    {{/title}}

                                    {{#body}}
                                        <p class="local-uckk-public-cta__body">
                                            {{body}}
                                        </p>
                                    {{/body}}

                                    {{#url}}
                                        <p class="local-uckk-public-cta__action">
                                            <a
                                                class="{{#classes}}{{classes}}{{/classes}}{{^classes}}btn btn-primary local-uckk-public-cta__link{{/classes}}"
                                                href="{{url}}"
                                            >
                                                <span class="local-uckk-public-cta__link-label">
                                                    {{#actionlabel}}
                                                        {{actionlabel}}
                                                    {{/actionlabel}}
                                                    {{^actionlabel}}
                                                        {{#label}}
                                                            {{label}}
                                                        {{/label}}
                                                        {{^label}}
                                                            Continuer
                                                        {{/label}}
                                                    {{/actionlabel}}
                                                </span>
                                            </a>
                                        </p>
                                    {{/url}}
                                </section>
                            {{/cta}}
                        {{/hascta}}
                    </div>
                </aside>
            {{/hasaside}}
        </div>
    </div>
</div>