    Univers-Cité King Klown.

    @template local_uckk/faculty_hero

    Public Voie hero partial.

    Context:
    {
        "eyebrow": "",
        "title": "",
        "subtitle": "",
        "summary": "",
        "primary_cta": {
            "label": "",
            "target": ""
        },
        "secondary_cta": {
            "label": "",
            "target": ""
        }
    }

    This template must not:
    - query Moodle data;
    - decide permissions;
    - create fallback content;
    - expose private user data;
    - expose completion, grades, notes, participants, enrolments, or submissions;
    - present UCKK internal recognitions as public accredited degrees;
    - introduce undocumented variables.
}}

<header
    class="local-uckk-faculty-hero local-uckk-public-hero"
    data-region="local-uckk-faculty-hero"
>
    <div class="local-uckk-faculty-hero__inner local-uckk-public-hero__inner">
        {{#eyebrow}}
            <p class="local-uckk-faculty-hero__eyebrow local-uckk-public-eyebrow">
                {{eyebrow}}
            </p>
        {{/eyebrow}}

        {{#title}}
            <h1 class="local-uckk-faculty-hero__title local-uckk-public-title">
                {{title}}
            </h1>
        {{/title}}

        {{#subtitle}}
            <p class="local-uckk-faculty-hero__subtitle local-uckk-public-subtitle">
                {{subtitle}}
            </p>
        {{/subtitle}}

        {{#summary}}
            <div class="local-uckk-faculty-hero__summary local-uckk-public-summary">
                {{summary}}
            </div>
        {{/summary}}

        {{#primary_cta.target}}
            {{#primary_cta.label}}
                <div class="local-uckk-faculty-hero__actions">
                    <a
                        class="local-uckk-faculty-hero__action local-uckk-faculty-hero__action--primary"
                        href="{{primary_cta.target}}"
                    >
                        {{primary_cta.label}}
                    </a>

                    {{#secondary_cta.target}}
                        {{#secondary_cta.label}}
                            <a
                                class="local-uckk-faculty-hero__action local-uckk-faculty-hero__action--secondary"
                                href="{{secondary_cta.target}}"
                            >
                                {{secondary_cta.label}}
                            </a>
                        {{/secondary_cta.label}}
                    {{/secondary_cta.target}}
                </div>
            {{/primary_cta.label}}
        {{/primary_cta.target}}

        {{^primary_cta.target}}
            {{#secondary_cta.target}}
                {{#secondary_cta.label}}
                    <div class="local-uckk-faculty-hero__actions">
                        <a
                            class="local-uckk-faculty-hero__action local-uckk-faculty-hero__action--secondary"
                            href="{{secondary_cta.target}}"
                        >
                            {{secondary_cta.label}}
                        </a>
                    </div>
                {{/secondary_cta.label}}
            {{/secondary_cta.target}}
        {{/primary_cta.target}}
    </div>
</header>
