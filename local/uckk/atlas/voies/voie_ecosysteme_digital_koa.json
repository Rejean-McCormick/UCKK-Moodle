  "titre_symbolique": "Architecte de l’écosystème digital kOA",
  "parchemin": "Parchemin de Puissance opératoire — Voie de l’Architecture de l’écosystème digital kOA",
  "definition_courte": "La Voie de l’Architecture de l’écosystème digital kOA forme des personnes capables de comprendre, déployer, auditer et gouverner une infrastructure numérique sociotechnique orientée vers la connaissance, la décision, l’action et la mémoire.",
  "angle_fondamental": "Transformer un groupe, une communauté ou une institution en organisation capable de connaître, choisir, agir et se souvenir avec méthode, légitimité, auditabilité et résilience.",
  "competence_centrale": "Concevoir, relier, déployer et gouverner les modules du kOA Digital Ecosystem afin de transformer des contributions en connaissances vérifiables, des connaissances en décisions légitimes, des décisions en actions coordonnées et des actions en mémoire réutilisable.",
  "seuils_progression": [
    {
      "seuil_id": "architecture_generale",
      "nom": "Architecture générale",
      "fonction": "Comprendre le kOA Digital Ecosystem comme système de systèmes sociotechnique."
    },
    {
      "seuil_id": "connaissance_et_decision",
      "nom": "Connaissance et décision",
      "fonction": "Structurer la matière collective, le sens, les preuves, l’incertitude et la décision légitime."
    },
    {
      "seuil_id": "execution_memoire_resilience",
      "nom": "Exécution, mémoire et résilience",
      "fonction": "Transformer les décisions en actions coordonnées, en mémoire institutionnelle et en infrastructure non dominatrice."
    }
  ],
