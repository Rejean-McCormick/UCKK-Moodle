{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "local/uckk/content/faculties/faculty_schema.json",
  "title": "UCKK Faculty Profile Schema",
  "description": "Schéma canonique des profils publics de faculté UCKK pour local_uckk.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "faculty_id",
    "voie_id",
    "slug",
    "status",
    "visibility",
    "source_atlas",
    "moodle",
    "identity",
    "seo",
    "hero",
    "navigation",
    "sections",
    "atlas_projection",
    "dynamic_blocks",
    "featured_blocks",
    "faq",
    "contact",
    "governance",
    "cache"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "UCKK-FACULTY-0.1"
    },
    "faculty_id": {
      "type": "string",
      "enum": [
        "faculty_grand_jeu_social",
        "faculty_economie",
        "faculty_ecologie",
        "faculty_sciences_politiques",
        "faculty_linguistique_architecture_du_sens",
        "faculty_metaphysique",
        "faculty_ia_gouvernable",
        "faculty_intervention_sociale_systemes_humains",
        "faculty_architecture_sociotechnique",
        "faculty_ecosysteme_digital_koa"
      ]
    },
    "voie_id": {
      "type": "string",
      "enum": [
        "voie_grand_jeu_social",
        "voie_economie",
        "voie_ecologie",
        "voie_sciences_politiques",
        "voie_linguistique_architecture_du_sens",
        "voie_metaphysique",
        "voie_ia_gouvernable",
        "voie_intervention_sociale_systemes_humains",
        "voie_architecture_sociotechnique",
        "voie_ecosysteme_digital_koa"
      ]
    },
    "slug": {
      "type": "string",
      "enum": [
        "grand-jeu-social",
        "economie",
        "ecologie",
        "sciences-politiques",
        "linguistique-architecture-du-sens",
        "metaphysique",
        "ia-gouvernable",
        "intervention-sociale-systemes-humains",
        "architecture-sociotechnique",
        "ecosysteme-digital-koa"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ]
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "hidden",
        "restricted"
      ]
    },
    "source_atlas": {
      "$ref": "#/$defs/source_atlas"
    },
    "moodle": {
      "$ref": "#/$defs/moodle"
    },
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "seo": {
      "$ref": "#/$defs/seo"
    },
    "hero": {
      "$ref": "#/$defs/hero"
    },
    "navigation": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/navigation_item"
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "atlas_projection": {
      "$ref": "#/$defs/atlas_projection"
    },
    "dynamic_blocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dynamic_block"
      }
    },
    "featured_blocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/featured_block"
      }
    },
    "faq": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/faq_item"
      }
    },
    "contact": {
      "$ref": "#/$defs/contact"
    },
    "governance": {
      "$ref": "#/$defs/governance"
    },
    "cache": {
      "$ref": "#/$defs/cache"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "faculty_id": {
            "const": "faculty_grand_jeu_social"
          }
        },
        "required": [
          "faculty_id"
        ]
      },
      "then": {
        "properties": {
          "voie_id": {
            "const": "voie_grand_jeu_social"
          },
          "slug": {
            "const": "grand-jeu-social"
          },
          "source_atlas": {
            "properties": {
              "file": {
                "const": "voie_grand_jeu_social.json"
              }
            }
          },
          "moodle": {
            "properties": {
              "category_idnumber": {
                "const": "UCKK-GJS"
              },
              "course_prefix": {
                "const": "GJS"
              },
              "hub_course_idnumber": {
                "const": "GJS-HUB"
              }
            }
          }
