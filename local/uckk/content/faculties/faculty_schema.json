  ],
  "$defs": {
    "string": {
      "type": "string"
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "anchor_target": {
      "type": "string",
      "pattern": "^(#[a-z0-9]+(?:-[a-z0-9]+)*|/local/uckk/[A-Za-z0-9_./?=&%-]+|https://[^\\s]+)$"
    },
    "id_slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "source_atlas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "schema_version_expected",
        "sync_mode"
      ],
      "properties": {
        "file": {
          "type": "string",
          "enum": [
            "voie_grand_jeu_social.json",
            "voie_economie.json",
            "voie_ecologie.json",
            "voie_sciences_politiques.json",
            "voie_linguistique_architecture_du_sens.json",
            "voie_metaphysique.json",
            "voie_ia_gouvernable.json",
            "voie_intervention_sociale_systemes_humains.json",
            "voie_architecture_sociotechnique.json",
            "voie_ecosysteme_digital_koa.json"
          ]
        },
        "schema_version_expected": {
          "type": "string",
          "const": "UCKK-ATLAS-0.2-draft"
        },
        "sync_mode": {
          "type": "string",
          "enum": [
            "read_only",
            "preview_only",
            "moodle_sync_allowed"
          ]
        }
      }
    },
    "moodle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category_id",
        "category_idnumber",
        "course_prefix",
        "public_course_listing",
        "enrolment_visibility",
        "hub_course_idnumber"
      ],
      "properties": {
        "category_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "category_idnumber": {
          "type": "string",
          "enum": [
            "UCKK-GJS",
            "UCKK-EC",
            "UCKK-ECL",
            "UCKK-SP",
            "UCKK-LI",
            "UCKK-ME",
            "UCKK-IA",
            "UCKK-IS",
            "UCKK-AS",
            "UCKK-KOA"
          ]
        },
        "course_prefix": {
          "type": "string",
          "enum": [
            "GJS",
            "EC",
            "ECL",
            "SP",
            "LI",
            "ME",
            "IA",
            "IS",
            "AS",
            "KOA"
          ]
        },
        "public_course_listing": {
          "type": "boolean"
        },
        "enrolment_visibility": {
          "type": "string",
          "enum": [
            "hidden",
            "public_info_only",
            "login_required",
            "enrolment_required"
          ]
        },
        "hub_course_idnumber": {
          "type": "string",
          "enum": [
            "GJS-HUB",
            "EC-HUB",
            "ECL-HUB",
            "SP-HUB",
            "LI-HUB",
            "ME-HUB",
            "IA-HUB",
            "IS-HUB",
            "AS-HUB",
            "KOA-HUB"
          ]
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eyebrow",
        "name",
        "short_name",
        "title_symbolique",
        "domain",
        "level",
        "faculty_role",
        "one_sentence"
      ],
      "properties": {
        "eyebrow": {
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/non_empty_string"
        },
        "short_name": {
          "$ref": "#/$defs/non_empty_string"
        },
        "title_symbolique": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "level": {
          "type": "string"
        },
        "faculty_role": {
          "type": "string"
        },
        "one_sentence": {
          "type": "string"
        }
      }
    },
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description",
        "keywords"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "keywords": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "uniqueItems": true
        }
      }
    },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "subtitle",
        "summary",
        "primary_cta",
        "secondary_cta"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/non_empty_string"
        },
        "subtitle": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "primary_cta": {
          "$ref": "#/$defs/cta"
        },
        "secondary_cta": {
          "$ref": "#/$defs/cta"
        }
      }
    },
    "cta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "target"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/anchor_target"
        }
      }
    },
    "navigation_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "target"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "target": {
          "$ref": "#/$defs/anchor_target"
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title",
        "body"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id_slug"
        },
        "type": {
          "type": "string",
          "enum": [
            "text",
            "markdown",
            "quote",
            "principle",
            "notice",
            "cards",
            "callout",
            "two_column"
          ]
        },
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/card_item"
          }
        },
        "columns": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/card_item"
          }
        }
      }
    },
    "card_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "body"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/anchor_target"
        }
      }
    },
    "atlas_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "show_definition_courte",
        "show_angle_fondamental",
        "show_competence_centrale",
        "show_seuils_progression",
        "show_courses",
        "show_course_codes",
        "show_concept_maitre",
        "show_concepts_associes",
        "show_artefacts",
        "show_criteres_passage",
        "show_projet_final",
        "show_limites_ethiques",
        "show_relations_intervoies",
        "show_tags"
      ],
      "properties": {
        "show_definition_courte": {
          "type": "boolean"
        },
        "show_angle_fondamental": {
          "type": "boolean"
        },
        "show_competence_centrale": {
          "type": "boolean"
        },
        "show_seuils_progression": {
          "type": "boolean"
        },
        "show_courses": {
          "type": "boolean"
        },
        "show_course_codes": {
          "type": "boolean"
        },
        "show_concept_maitre": {
          "type": "boolean"
        },
        "show_concepts_associes": {
          "type": "boolean"
        },
        "show_artefacts": {
          "type": "boolean"
        },
        "show_criteres_passage": {
          "type": "boolean"
        },
        "show_projet_final": {
          "type": "boolean"
        },
        "show_limites_ethiques": {
          "type": "boolean"
        },
        "show_relations_intervoies": {
          "type": "boolean"
        },
        "show_tags": {
          "type": "boolean"
        }
      }
    },
    "dynamic_block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title",
        "source",
        "limit",
        "visibility",
        "empty_state"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id_slug"
        },
        "type": {
          "type": "string",
          "enum": [
            "announcements",
            "events",
            "moodle_course_list",
            "featured_courses",
            "faculty_news",
            "related_faculties",
            "public_resources",
            "cta_panel"
          ]
        },
        "title": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/dynamic_source"
        },
        "limit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        },
        "visibility": {
          "type": "string",
          "enum": [
            "public",
            "hidden",
            "restricted"
          ]
        },
        "empty_state": {
          "type": "string"
        }
      }
    },
    "dynamic_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "moodle_forum",
            "moodle_calendar",
            "moodle_category",
            "moodle_course_customfield",
            "local_uckk_news",
            "local_uckk_manual",
            "none"
          ]
        },
        "course_idnumber": {
          "type": "string"
        },
        "forum_name": {
          "type": "string"
        },
        "category_idnumber": {
          "type": "string"
        },
        "customfield": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/manual_source_item"
          }
        }
      }
    },
    "manual_source_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "url"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "url": {
          "$ref": "#/$defs/anchor_target"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "featured_block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "title",
        "body"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "principle",
            "notice",
            "warning",
            "quote",
            "stat",
            "method",
            "ethics",
            "cta"
          ]
        },
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/anchor_target"
        }
      }
    },
    "faq_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "answer"
      ],
      "properties": {
        "question": {
          "type": "string"
        },
        "answer": {
          "type": "string"
        }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "body",
        "email",
        "cta"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "cta": {
          "$ref": "#/$defs/cta"
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "editorial_status",
        "last_reviewed",
        "review_notes",
        "public_claims_guardrails"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "const": "local_uckk"
        },
        "editorial_status": {
          "type": "string",
          "enum": [
            "draft",
            "review",
            "approved",
            "needs_update",
            "archived"
          ]
        },
        "last_reviewed": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "review_notes": {
          "type": "string"
        },
        "public_claims_guardrails": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "ttl_seconds"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ttl_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800
        }
      }
    }
  }
}