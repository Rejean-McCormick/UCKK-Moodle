<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="ai/provider/uckk/db" VERSION="2026051200" COMMENT="XMLDB file for the UCKK AI provider"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="../../../../lib/xmldb/xmldb.xsd">
  <TABLES>
    <TABLE NAME="aiprovider_uckk_log" COMMENT="UCKK AI prompt and response audit log">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>

        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="contextid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>

        <FIELD NAME="actionname" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="provider" TYPE="char" LENGTH="100" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="model" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="endpoint" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>

        <FIELD NAME="requestid" TYPE="char" LENGTH="128" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="status" TYPE="char" LENGTH="32" NOTNULL="true" DEFAULT="success" SEQUENCE="false"/>

        <FIELD NAME="prompttext" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="responsetext" TYPE="text" NOTNULL="false" SEQUENCE="false"/>

        <FIELD NAME="promptredacted" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="responseredacted" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>

        <FIELD NAME="prompttokens" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="responsetokens" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="durationms" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>

        <FIELD NAME="errorcode" TYPE="char" LENGTH="100" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="errormessage" TYPE="text" NOTNULL="false" SEQUENCE="false"/>

        <FIELD NAME="metadata" TYPE="text" NOTNULL="false" SEQUENCE="false"/>

        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>

      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userid_fk" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="contextid_fk" TYPE="foreign" FIELDS="contextid" REFTABLE="context" REFFIELDS="id"/>
      </KEYS>

      <INDEXES>
        <INDEX NAME="userid_ix" UNIQUE="false" FIELDS="userid"/>
        <INDEX NAME="contextid_ix" UNIQUE="false" FIELDS="contextid"/>
        <INDEX NAME="actionname_ix" UNIQUE="false" FIELDS="actionname"/>
        <INDEX NAME="status_ix" UNIQUE="false" FIELDS="status"/>
        <INDEX NAME="requestid_ix" UNIQUE="false" FIELDS="requestid"/>
        <INDEX NAME="timecreated_ix" UNIQUE="false" FIELDS="timecreated"/>
        <INDEX NAME="user_action_time_ix" UNIQUE="false" FIELDS="userid, actionname, timecreated"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>