<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/uckkchallenge/db" VERSION="2026051200" COMMENT="XMLDB file for UCKK Challenge activity module"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
    <TABLES>
        <TABLE NAME="uckkchallenge" COMMENT="UCKK Challenge activity instances">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT=""/>
                <FIELD NAME="intro" TYPE="text" NOTNULL="false"/>
                <FIELD NAME="introformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0"/>

                <FIELD NAME="challengecode" TYPE="char" LENGTH="100" NOTNULL="false"/>
                <FIELD NAME="challengetype" TYPE="char" LENGTH="64" NOTNULL="true" DEFAULT="internal_learning"/>

                <FIELD NAME="statement" TYPE="text" NOTNULL="false"/>
                <FIELD NAME="statementformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="1"/>
                <FIELD NAME="contexttext" TYPE="text" NOTNULL="false"/>
                <FIELD NAME="contexttextformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="1"/>
                <FIELD NAME="rules" TYPE="text" NOTNULL="false"/>
                <FIELD NAME="rulesformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="1"/>
                <FIELD NAME="corridors" TYPE="text" NOTNULL="false"/>
                <FIELD NAME="corridorsformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="1"/>
                <FIELD NAME="ethicalconstraints" TYPE="text" NOTNULL="false"/>
                <FIELD NAME="ethicalconstraintsformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="1"/>

                <FIELD NAME="evidencepolicy" TYPE="text" NOTNULL="false"/>
                <FIELD NAME="evidencepolicyformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="1"/>
                <FIELD NAME="criteria" TYPE="text" NOTNULL="false"/>
                <FIELD NAME="criteriaformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="1"/>

                <FIELD NAME="teamsubmissions" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="maxsubmissions" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="1"/>
                <FIELD NAME="allowresubmission" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1"/>

                <FIELD NAME="integrityrequired" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1"/>
                <FIELD NAME="integritynotes" TYPE="text" NOTNULL="false"/>
                <FIELD NAME="integritynotesformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="1"/>

                <FIELD NAME="aipolicy" TYPE="text" NOTNULL="false"/>
                <FIELD NAME="aipolicyformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="1"/>

                <FIELD NAME="visibility" TYPE="char" LENGTH="64" NOTNULL="true" DEFAULT="course"/>
                <FIELD NAME="archivepolicy" TYPE="char" LENGTH="64" NOTNULL="true" DEFAULT="summary"/>
                <FIELD NAME="publicsummary" TYPE="text" NOTNULL="false"/>
                <FIELD NAME="publicsummaryformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="1"/>

                <FIELD NAME="competencylinks" TYPE="text" NOTNULL="false"/>
                <FIELD NAME="badgelinks" TYPE="text" NOTNULL="false"/>

                <FIELD NAME="completionrequiresubmission" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="completionrequirevalidation" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>

                <FIELD NAME="status" TYPE="char" LENGTH="64" NOTNULL="true" DEFAULT="draft"/>
                <FIELD NAME="timeopen" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="timeclose" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="timereviewby" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>

                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="createdby" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="modifiedby" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="versionno" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="1"/>
                <FIELD NAME="provenancehash" TYPE="char" LENGTH="128" NOTNULL="false"/>
                <FIELD NAME="metadata" TYPE="text" NOTNULL="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="course_idx" UNIQUE="false" FIELDS="course"/>
                <INDEX NAME="code_idx" UNIQUE="false" FIELDS="challengecode"/>
                <INDEX NAME="type_idx" UNIQUE="false" FIELDS="challengetype"/>
                <INDEX NAME="status_idx" UNIQUE="false" FIELDS="status"/>
                <INDEX NAME="visibility_idx" UNIQUE="false" FIELDS="visibility"/>
                <INDEX NAME="timeopen_idx" UNIQUE="false" FIELDS="timeopen"/>
                <INDEX NAME="timeclose_idx" UNIQUE="false" FIELDS="timeclose"/>
                <INDEX NAME="createdby_idx" UNIQUE="false" FIELDS="createdby"/>
                <INDEX NAME="modifiedby_idx" UNIQUE="false" FIELDS="modifiedby"/>
            </INDEXES>
        </TABLE>

