<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/uckkarchive/db" VERSION="2026051200" COMMENT="XMLDB file for UCKK Archive activity module"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
    <TABLES>
        <TABLE NAME="uckkarchive" COMMENT="UCKK archive activity instances.">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Moodle course id for the activity instance."/>
                <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT="" SEQUENCE="false" COMMENT="Archive activity name."/>
                <FIELD NAME="intro" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Archive introduction."/>
                <FIELD NAME="introformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Format of the archive introduction."/>
                <FIELD NAME="archivecode" TYPE="char" LENGTH="100" NOTNULL="false" SEQUENCE="false" COMMENT="Stable internal archive code."/>
                <FIELD NAME="archivetype" TYPE="char" LENGTH="64" NOTNULL="true" DEFAULT="course" SEQUENCE="false" COMMENT="Archive scope type."/>
                <FIELD NAME="archivepolicy" TYPE="char" LENGTH="64" NOTNULL="true" DEFAULT="validated" SEQUENCE="false" COMMENT="Policy controlling item publication and export."/>
                <FIELD NAME="defaultvisibility" TYPE="char" LENGTH="64" NOTNULL="true" DEFAULT="course" SEQUENCE="false" COMMENT="Default visibility for new archive items."/>
                <FIELD NAME="requirevalidation" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false" COMMENT="Whether items require validation before publication."/>
                <FIELD NAME="allowpublicitems" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Whether public archive items are allowed in this instance."/>
                <FIELD NAME="allowexports" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false" COMMENT="Whether exports may be requested from this archive."/>
                <FIELD NAME="completionrequireitem" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Completion requires at least one archive item."/>
                <FIELD NAME="completionrequirevalidation" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Completion requires a validated archive item."/>
                <FIELD NAME="status" TYPE="char" LENGTH="64" NOTNULL="true" DEFAULT="active" SEQUENCE="false" COMMENT="Archive activity status."/>
                <FIELD NAME="visibility" TYPE="char" LENGTH="64" NOTNULL="true" DEFAULT="course" SEQUENCE="false" COMMENT="Archive activity visibility."/>
                <FIELD NAME="versionno" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="1" SEQUENCE="false" COMMENT="Archive configuration version."/>
                <FIELD NAME="createdby" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="User who created the archive instance."/>
                <FIELD NAME="modifiedby" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="User who last modified the archive instance."/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Creation time."/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Last modification time."/>
                <FIELD NAME="metadata" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="JSON metadata for variable archive settings."/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="course" TYPE="foreign" FIELDS="course" REFTABLE="course" REFFIELDS="id"/>
                <KEY NAME="createdby" TYPE="foreign" FIELDS="createdby" REFTABLE="user" REFFIELDS="id"/>
                <KEY NAME="modifiedby" TYPE="foreign" FIELDS="modifiedby" REFTABLE="user" REFFIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="archivecode" UNIQUE="false" FIELDS="archivecode"/>
                <INDEX NAME="status" UNIQUE="false" FIELDS="status"/>
                <INDEX NAME="visibility" UNIQUE="false" FIELDS="visibility"/>
                <INDEX NAME="timemodified" UNIQUE="false" FIELDS="timemodified"/>
            </INDEXES>
        </TABLE>

        <TABLE NAME="uckkarchive_item" COMMENT="Archive items: proof, decisions, minutes, challenge results, course works, portfolio entries, Kristals, integrity summaries, and public summaries.">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="archiveid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Parent archive instance."/>
