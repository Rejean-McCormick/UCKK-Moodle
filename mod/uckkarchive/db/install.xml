                <FIELD NAME="visibility" TYPE="char" LENGTH="64" NOTNULL="true" DEFAULT="course" SEQUENCE="false" COMMENT="Archive item visibility."/>
                <FIELD NAME="provenance" TYPE="char" LENGTH="64" NOTNULL="true" DEFAULT="human" SEQUENCE="false" COMMENT="Primary provenance source."/>
                <FIELD NAME="provenancehash" TYPE="char" LENGTH="128" NOTNULL="false" SEQUENCE="false" COMMENT="Optional provenance hash."/>
                <FIELD NAME="integritycaseid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Linked integrity case id when applicable."/>
                <FIELD NAME="versionno" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="1" SEQUENCE="false" COMMENT="Archive item version number."/>
                <FIELD NAME="createdby" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="User who created this item."/>
                <FIELD NAME="modifiedby" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="User who last modified this item."/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Creation time."/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Modification time."/>
                <FIELD NAME="metadata" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="JSON metadata for variable archive item properties."/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="archiveid" TYPE="foreign" FIELDS="archiveid" REFTABLE="uckkarchive" REFFIELDS="id"/>
                <KEY NAME="courseid" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
                <KEY NAME="cmid" TYPE="foreign" FIELDS="cmid" REFTABLE="course_modules" REFFIELDS="id"/>
                <KEY NAME="contextid" TYPE="foreign" FIELDS="contextid" REFTABLE="context" REFFIELDS="id"/>
                <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
                <KEY NAME="parentitemid" TYPE="foreign" FIELDS="parentitemid" REFTABLE="uckkarchive_item" REFFIELDS="id"/>
                <KEY NAME="createdby" TYPE="foreign" FIELDS="createdby" REFTABLE="user" REFFIELDS="id"/>
                <KEY NAME="modifiedby" TYPE="foreign" FIELDS="modifiedby" REFTABLE="user" REFFIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="archive-status" UNIQUE="false" FIELDS="archiveid, status"/>
                <INDEX NAME="archive-type" UNIQUE="false" FIELDS="archiveid, itemtype"/>
                <INDEX NAME="archive-validation" UNIQUE="false" FIELDS="archiveid, validationstate"/>
                <INDEX NAME="visibility" UNIQUE="false" FIELDS="visibility"/>
                <INDEX NAME="source" UNIQUE="false" FIELDS="sourcecomponent, sourceobjectid"/>
                <INDEX NAME="origin" UNIQUE="false" FIELDS="origincomponent, originobjectid"/>
                <INDEX NAME="integritycaseid" UNIQUE="false" FIELDS="integritycaseid"/>
                <INDEX NAME="provenancehash" UNIQUE="false" FIELDS="provenancehash"/>
                <INDEX NAME="timemodified" UNIQUE="false" FIELDS="timemodified"/>
            </INDEXES>
        </TABLE>

