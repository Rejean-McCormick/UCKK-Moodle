/**
 * UCKK theme main SCSS.
 *
 * This file defines the visual identity layer for UCKK-Moodle.
 *
 * It styles only UCKK-owned templates and shared UCKK interface patterns.
 * It must not take ownership of Moodle/Boost page layout, drawers, navigation,
 * course editing controls, grading UI, permissions, workflow state, or data logic.
 *
 * @package    theme_uckk
 * @copyright  2026 UCKK
 * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
 */

/* ========================================================================== 
   UCKK brand tokens
   ========================================================================== */

$theme-uckk-black: #172321 !default; // Institutional ink.
$theme-uckk-black-soft: #0f1f1d !default;
$theme-uckk-ivory: #f7f1df !default; // Parchment / institutional paper.
$theme-uckk-ivory-muted: #eadfbd !default;
$theme-uckk-red: #8f2f2f !default; // Burgundy signal; no longer primary brand.
$theme-uckk-red-dark: #642020 !default;
$theme-uckk-gold: #b9934b !default; // Aged gold / bronze.
$theme-uckk-gold-soft: #d6bd7a !default;
$theme-uckk-blue: #54736f !default; // Blue-green grey / civic shadow.
$theme-uckk-blue-soft: #78918d !default;
$theme-uckk-green: #1e6864 !default; // UCKK brand petroleum green.
$theme-uckk-green-soft: #dfeee9 !default;
$theme-uckk-white: #fffaf0 !default;
$theme-uckk-grey-100: #f4efe3 !default;
$theme-uckk-grey-200: #e7ddca !default;
$theme-uckk-grey-300: #d2c5ab !default;
$theme-uckk-grey-600: #5d6f6a !default;
$theme-uckk-grey-800: #243632 !default;

$theme-uckk-font-title: Georgia, "Times New Roman", serif !default;
$theme-uckk-font-display: Cambria, Georgia, "Times New Roman", serif !default;
$theme-uckk-font-body: system-ui, -apple-system, "Segoe UI", Arial, sans-serif !default;

$theme-uckk-radius-sm: .375rem !default;
$theme-uckk-radius: .75rem !default;
$theme-uckk-radius-lg: 1.25rem !default;
$theme-uckk-radius-xl: 2rem !default;

$theme-uckk-shadow-sm: 0 .25rem .75rem rgba(23, 35, 33, .1) !default;
$theme-uckk-shadow: 0 1rem 2.5rem rgba(23, 35, 33, .16) !default;
$theme-uckk-shadow-lg: 0 2rem 4rem rgba(23, 35, 33, .24) !default;

$theme-uckk-border-soft: 1px solid rgba(185, 147, 75, .28) !default;
$theme-uckk-border-dark: 1px solid rgba(23, 35, 33, .14) !default;
$theme-uckk-border-gold: 1px solid rgba(185, 147, 75, .42) !default;

$theme-uckk-transition: 160ms ease-in-out !default;

/* ========================================================================== 
   Mixins
   ========================================================================== */

@mixin theme-uckk-eyebrow-text {
    color: var(--uckk-gold);
    font-family: $theme-uckk-font-body;
    font-size: .765625rem;
    font-weight: 800;
    letter-spacing: .14em;
    text-transform: uppercase;
}

@mixin theme-uckk-focus-ring {
    outline: .1875rem solid var(--uckk-green);
    outline-offset: .1875rem;
}

/* ========================================================================== 
   CSS custom properties
   ========================================================================== */

:root {
    --uckk-black: #{$theme-uckk-black};
    --uckk-black-soft: #{$theme-uckk-black-soft};
    --uckk-ivory: #{$theme-uckk-ivory};
    --uckk-ivory-muted: #{$theme-uckk-ivory-muted};
    --uckk-red: #{$theme-uckk-red};
    --uckk-red-dark: #{$theme-uckk-red-dark};
    --uckk-gold: #{$theme-uckk-gold};
    --uckk-gold-soft: #{$theme-uckk-gold-soft};
    --uckk-blue: #{$theme-uckk-blue};
    --uckk-blue-soft: #{$theme-uckk-blue-soft};
    --uckk-green: #{$theme-uckk-green};
    --uckk-green-soft: #{$theme-uckk-green-soft};
    --uckk-white: #{$theme-uckk-white};
    --uckk-grey-100: #{$theme-uckk-grey-100};
    --uckk-grey-200: #{$theme-uckk-grey-200};
    --uckk-grey-300: #{$theme-uckk-grey-300};
    --uckk-grey-600: #{$theme-uckk-grey-600};
    --uckk-grey-800: #{$theme-uckk-grey-800};
    --uckk-radius-sm: #{$theme-uckk-radius-sm};
    --uckk-radius: #{$theme-uckk-radius};
    --uckk-radius-lg: #{$theme-uckk-radius-lg};
    --uckk-radius-xl: #{$theme-uckk-radius-xl};
    --uckk-shadow-sm: #{$theme-uckk-shadow-sm};
    --uckk-shadow: #{$theme-uckk-shadow};
    --uckk-shadow-lg: #{$theme-uckk-shadow-lg};
    --uckk-petrol: #{$theme-uckk-green};
    --uckk-paper: #{$theme-uckk-ivory};
    --uckk-ink: #{$theme-uckk-black};
    --uckk-bronze: #{$theme-uckk-gold};
    --uckk-bluegrey: #{$theme-uckk-blue};
    --uckk-font-title: #{$theme-uckk-font-title};
    --uckk-font-display: #{$theme-uckk-font-display};
    --uckk-font-body: #{$theme-uckk-font-body};
}

/* ========================================================================== 
   Shared UCKK components
   ========================================================================== */

.theme-uckk-surface {
    background: var(--uckk-paper);
    border: $theme-uckk-border-gold;
    border-radius: var(--uckk-radius);
    box-shadow: var(--uckk-shadow-sm);
}

.theme-uckk-surface-dark {
    background: var(--uckk-petrol-deep);
    color: var(--uckk-ivory);
    border: $theme-uckk-border-soft;
    border-radius: var(--uckk-radius);
    box-shadow: var(--uckk-shadow);
}

.theme-uckk-eyebrow {
    @include theme-uckk-eyebrow-text;
}

.theme-uckk-muted {
    color: var(--uckk-grey-600);
}

.theme-uckk-divider {
    width: 100%;
    height: 1px;
    margin: 1.5rem 0;
    background: rgba(185, 147, 75, .5);
}

.theme-uckk-focus-ring:focus,
.theme-uckk-focus-ring:focus-visible {
    @include theme-uckk-focus-ring;
}

.theme-uckk-official-label {
    @include theme-uckk-eyebrow-text;
    color: var(--uckk-petrol);
}

.theme-uckk-cartouche {
    padding: 1rem 1.25rem;
    color: var(--uckk-ink);
    background: var(--uckk-paper-soft);
    border: $theme-uckk-border-gold;
    border-left: .35rem solid var(--uckk-petrol);
    border-radius: var(--uckk-radius);
}

.theme-uckk-medallion {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    color: var(--uckk-petrol);
    background: var(--uckk-paper);
    border: 1px solid rgba(185, 147, 75, .48);
    border-radius: 999rem;
    box-shadow: inset 0 0 0 .25rem rgba(255, 250, 240, .72);
}

/* ========================================================================== 
   Front page component
   ========================================================================== */

.theme-uckk-frontpage {
    background:
        radial-gradient(circle at 14% 0%, rgba(185, 147, 75, .24), transparent 30rem),
        radial-gradient(circle at 88% 10%, rgba(30, 104, 100, .26), transparent 26rem),
        linear-gradient(180deg, var(--uckk-ink) 0%, var(--uckk-petrol) 36rem, var(--uckk-paper) 36rem);
    color: var(--uckk-ink);
    overflow: hidden;
    font-family: $theme-uckk-font-body;

    .btn-primary {
        background: var(--uckk-petrol);
        border-color: var(--uckk-petrol);
        color: var(--uckk-white);
        box-shadow: 0 .5rem 1.25rem rgba(30, 104, 100, .28);

        &:hover,
        &:focus {
            background: var(--uckk-ink);
            border-color: var(--uckk-ink);
            color: var(--uckk-white);
            box-shadow: 0 .75rem 1.75rem rgba(30, 104, 100, .36);
        }
    }

    .btn-outline-primary {
        border-color: var(--uckk-gold);
        color: var(--uckk-ivory);

        &:hover,
        &:focus {
            background: var(--uckk-gold);
            border-color: var(--uckk-gold);
            color: var(--uckk-black);
        }
    }

    .btn-outline-secondary {
        border-color: rgba(11, 11, 15, .4);
        color: var(--uckk-black);

        &:hover,
        &:focus {
            background: var(--uckk-black);
            border-color: var(--uckk-black);
            color: var(--uckk-white);
        }
    }

    a {
        transition:
            color $theme-uckk-transition,
            background-color $theme-uckk-transition,
            border-color $theme-uckk-transition,
            box-shadow $theme-uckk-transition,
            transform $theme-uckk-transition;
    }
}

.theme-uckk-frontpage__hero {
    position: relative;
    color: var(--uckk-ivory);
    padding: 5rem 0 4rem;

    &::before {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        opacity: .16;
        background-image:
            linear-gradient(rgba(255, 255, 255, .15) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255, 255, 255, .15) 1px, transparent 1px);
        background-size: 4rem 4rem;
        mask-image: linear-gradient(180deg, #000, transparent 92%);
        -webkit-mask-image: linear-gradient(180deg, #000, transparent 92%);
    }
}

.theme-uckk-frontpage__hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(18rem, .75fr);
    gap: 2rem;
    align-items: center;
}

.theme-uckk-frontpage__hero-content {
    max-width: 48rem;
}

.theme-uckk-frontpage__seal {
    display: inline-flex;
    align-items: center;
    gap: .75rem;
    max-width: 100%;
    margin-bottom: 1.5rem;
    padding: .625rem .875rem;
    background: rgba(255, 255, 255, .08);
    border: $theme-uckk-border-soft;
    border-radius: 999rem;
}

@supports (backdrop-filter: blur(.5rem)) or (-webkit-backdrop-filter: blur(.5rem)) {
    .theme-uckk-frontpage__seal,
    .theme-uckk-frontpage__formula-card {
        backdrop-filter: blur(.5rem);
        -webkit-backdrop-filter: blur(.5rem);
    }

    .theme-uckk-frontpage__formula-card {
        backdrop-filter: blur(.75rem);
        -webkit-backdrop-filter: blur(.75rem);
    }
}

.theme-uckk-frontpage__seal-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    flex: 0 0 auto;

    img,
    svg {
        max-width: 100%;
        height: auto;
    }
}

.theme-uckk-frontpage__seal-text {
    color: var(--uckk-ivory-muted);
    font-size: .875rem;
    font-weight: 700;
    letter-spacing: .04em;
}

.theme-uckk-frontpage__eyebrow {
    @include theme-uckk-eyebrow-text;
    margin-bottom: .75rem;
}

.theme-uckk-frontpage__title {
    margin: 0 0 1rem;
    color: var(--uckk-white);
    font-family: $theme-uckk-font-title;
    font-size: clamp(2.5rem, 6vw, 5.75rem);
    font-weight: 800;
    line-height: .95;
    letter-spacing: -.06em;
    text-wrap: balance;
}

.theme-uckk-frontpage__subtitle {
    max-width: 43rem;
    margin: 0 0 1rem;
    color: var(--uckk-ivory);
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    line-height: 1.5;
}

.theme-uckk-frontpage__slogan {
    max-width: 40rem;
    margin: 0 0 2rem;
    color: var(--uckk-gold-soft);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: .03em;
}

.theme-uckk-frontpage__actions {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem;
}

.theme-uckk-frontpage__primary-action,
.theme-uckk-frontpage__secondary-action {
    border-radius: 999rem;
    font-weight: 700;
}

.theme-uckk-frontpage__hero-panel {
    align-self: stretch;
}

.theme-uckk-frontpage__formula-card {
    position: relative;
    height: 100%;
    padding: 2rem;
    background:
        linear-gradient(145deg, rgba(255, 250, 240, .14), rgba(255, 250, 240, .04)),
        linear-gradient(180deg, rgba(185, 147, 75, .24), rgba(23, 35, 33, .3));
    border: $theme-uckk-border-soft;
    border-radius: var(--uckk-radius-xl);
    box-shadow: var(--uckk-shadow-lg);

    &::after {
        content: "";
        position: absolute;
        inset: 1rem;
        pointer-events: none;
        border: 1px solid rgba(185, 147, 75, .28);
        border-radius: calc(var(--uckk-radius-xl) - .5rem);
    }
}

.theme-uckk-frontpage__formula-title {
    position: relative;
    z-index: 1;
    margin: 0 0 1.5rem;
    color: var(--uckk-gold-soft);
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: .04em;
    text-transform: uppercase;
}

.theme-uckk-frontpage__formula-list {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;

    li {
        padding-left: 1.35rem;
        color: var(--uckk-ivory);
        font-size: 1rem;
        line-height: 1.45;

        &::before {
            content: "◆";
            display: inline-block;
            width: 1.35rem;
            margin-left: -1.35rem;
            color: var(--uckk-gold);
            font-size: .75rem;
            vertical-align: .1rem;
        }
    }
}

.theme-uckk-frontpage__formula-footer {
    position: relative;
    z-index: 1;
    margin: 1.5rem 0 0;
    color: var(--uckk-ivory-muted);
    font-size: .9375rem;
    line-height: 1.5;
}

.theme-uckk-frontpage__main {
    position: relative;
    padding: 4rem 0 5rem;
    background: var(--uckk-ivory);
}

.theme-uckk-frontpage__section-intro {
    max-width: 60rem;
    margin-bottom: 2rem;
}

.theme-uckk-frontpage__section-label {
    @include theme-uckk-eyebrow-text;
    color: var(--uckk-petrol);
    margin-bottom: .5rem;
}

.theme-uckk-frontpage__section-title {
    margin: 0;
    color: var(--uckk-ink);
    font-family: $theme-uckk-font-display;
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -.03em;
    text-wrap: balance;
}

.theme-uckk-frontpage__cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    margin-bottom: 3rem;
}

.theme-uckk-frontpage__card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 18rem;
    padding: 1.5rem;
    background:
        linear-gradient(180deg, rgba(255, 250, 240, .92), rgba(247, 241, 223, .96)),
        var(--uckk-paper);
    border: $theme-uckk-border-gold;
    border-radius: var(--uckk-radius-lg);
    box-shadow: var(--uckk-shadow-sm);
    transition:
        transform $theme-uckk-transition,
        box-shadow $theme-uckk-transition,
        border-color $theme-uckk-transition;

    &:hover,
    &:focus-within {
        transform: translateY(-.25rem);
        border-color: rgba(185, 147, 75, .5);
        box-shadow: var(--uckk-shadow);
    }
}

.theme-uckk-frontpage__card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    margin-bottom: 1rem;
    background: rgba(185, 147, 75, .15);
    border-radius: 999rem;

    img,
    svg {
        max-width: 1.75rem;
        height: auto;
    }
}

.theme-uckk-frontpage__card-title {
    margin: 0 0 .75rem;
    color: var(--uckk-black);
    font-size: 1.25rem;
    font-weight: 800;
    line-height: 1.2;
}

.theme-uckk-frontpage__card-text {
    flex: 1 1 auto;
    margin: 0 0 1rem;
    color: var(--uckk-grey-600);
    line-height: 1.55;
}

.theme-uckk-frontpage__card-link {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    align-self: flex-start;
    margin-top: auto;
    color: var(--uckk-red);
    font-weight: 700;
    text-decoration: none;

    &::after {
        content: "→";
        transition: transform $theme-uckk-transition;
    }

    &:hover,
    &:focus {
        color: var(--uckk-red-dark);
        text-decoration: underline;

        &::after {
            transform: translateX(.2rem);
        }
    }
}

/* ========================================================================== 
   Boundary and notice components
   ========================================================================== */

.theme-uckk-frontpage__boundary {
    margin: 0 0 2rem;
    padding: 2rem;
    background:
        linear-gradient(135deg, rgba(18, 26, 58, .98), rgba(11, 11, 15, .98)),
        var(--uckk-blue);
    color: var(--uckk-ivory);
    border-radius: var(--uckk-radius-xl);
    box-shadow: var(--uckk-shadow);
}

.theme-uckk-frontpage__boundary-title {
    margin: 0 0 1.25rem;
    color: var(--uckk-gold-soft);
    font-size: 1.375rem;
    font-weight: 800;
}

.theme-uckk-frontpage__boundary-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: .875rem;
}

.theme-uckk-frontpage__boundary-item {
    display: grid;
    gap: .35rem;
    padding: 1rem;
    background: rgba(255, 255, 255, .08);
    border: $theme-uckk-border-soft;
    border-radius: var(--uckk-radius);

    strong {
        color: var(--uckk-white);
        font-size: .9375rem;
    }

    span {
        color: var(--uckk-ivory-muted);
        font-size: .875rem;
        line-height: 1.45;
    }
}

.theme-uckk-frontpage__notices {
    display: grid;
    gap: 1rem;
}

.theme-uckk-frontpage__notice {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    padding: 1.25rem;
    background: var(--uckk-white);
    border: $theme-uckk-border-dark;
    border-radius: var(--uckk-radius-lg);
    box-shadow: var(--uckk-shadow-sm);
}

.theme-uckk-frontpage__notice-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    background: var(--uckk-grey-100);
    border-radius: 999rem;

    img,
    svg {
        max-width: 1.75rem;
        height: auto;
    }
}

.theme-uckk-frontpage__notice-content {
    min-width: 0;

    p {
        margin: 0 0 .75rem;
        color: var(--uckk-grey-800);
        line-height: 1.55;

        &:last-child {
            margin-bottom: 0;
        }
    }
}

.theme-uckk-frontpage__notice-title {
    margin: 0 0 .625rem;
    color: var(--uckk-black);
    font-size: 1.125rem;
    font-weight: 800;
}

.theme-uckk-frontpage__notice-emphasis {
    font-weight: 700;
}

.theme-uckk-frontpage__notice--integrity {
    border-left: .375rem solid var(--uckk-red);

    .theme-uckk-frontpage__notice-icon {
        background: rgba(179, 34, 34, .12);
    }
}

.theme-uckk-frontpage__notice--ai {
    grid-template-columns: minmax(0, 1fr);
    border-left: .375rem solid var(--uckk-green);
    background: linear-gradient(135deg, var(--uckk-green-soft), var(--uckk-white));
}

.theme-uckk-frontpage__notice--recognition {
    grid-template-columns: minmax(0, 1fr);
    border-left: .375rem solid var(--uckk-gold);
}

/* ========================================================================== 
   UCKK badges and markers
   ========================================================================== */

.theme-uckk-status,
.theme-uckk-visibility,
.theme-uckk-marker {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    padding: .25rem .55rem;
    border-radius: 999rem;
    font-size: .75rem;
    font-weight: 700;
    line-height: 1.2;
    white-space: nowrap;
}

.theme-uckk-status {
    background: var(--uckk-grey-200);
    color: var(--uckk-grey-800);
}

.theme-uckk-status--validated {
    background: var(--uckk-green-soft);
    color: var(--uckk-petrol);
}

.theme-uckk-status--contested,
.theme-uckk-status--correctionrequired {
    background: rgba(185, 147, 75, .18);
    color: #6b4d13;
}

.theme-uckk-status--invalidated {
    background: rgba(179, 34, 34, .12);
    color: var(--uckk-red-dark);
}

.theme-uckk-status--archived {
    background: rgba(84, 115, 111, .14);
    color: var(--uckk-bluegrey);
}

.theme-uckk-visibility {
    background: rgba(30, 104, 100, .08);
    color: var(--uckk-petrol);
}

.theme-uckk-marker--ai {
    background: var(--uckk-green-soft);
    color: var(--uckk-petrol);
}

.theme-uckk-marker--integrity {
    background: rgba(179, 34, 34, .12);
    color: var(--uckk-red-dark);
}

.theme-uckk-marker--archive {
    background: rgba(185, 147, 75, .18);
    color: #6b4d13;
}

/* ========================================================================== 
   Dashboard/card components
   ========================================================================== */

.theme-uckk-dashboard-shell {
    display: grid;
    gap: 1rem;
}

.theme-uckk-dashboard-card {
    padding: 1.25rem;
    background: var(--uckk-white);
    border: $theme-uckk-border-dark;
    border-radius: var(--uckk-radius-lg);
    box-shadow: var(--uckk-shadow-sm);
}

.theme-uckk-dashboard-card__title {
    margin: 0 0 .75rem;
    color: var(--uckk-black);
    font-size: 1.125rem;
    font-weight: 800;
}

.theme-uckk-dashboard-card__meta {
    color: var(--uckk-grey-600);
    font-size: .875rem;
}

.theme-uckk-progress-line {
    overflow: hidden;
    height: .625rem;
    background: var(--uckk-grey-200);
    border-radius: 999rem;
}

.theme-uckk-progress-line__bar {
    min-width: .25rem;
    height: 100%;
    background: var(--uckk-petrol);
    border-radius: inherit;
}

/* ==========================================================================
   UCKK global Boost skin — parchment / petrol / gold
   Applies beyond dashboard: admin pages, course management, category pages.
   No yellow/green gradients; surfaces follow the poster style.
   ========================================================================== */

:root {
    --uckk-petrol: #1e6864;
    --uckk-petrol-dark: #073f3b;
    --uckk-petrol-deep: #052f2d;
    --uckk-paper: #f4ecd2;
    --uckk-paper-soft: #fbf6e7;
    --uckk-paper-deep: #eadfbd;
    --uckk-gold: #c49a3a;
    --uckk-gold-soft: rgba(196, 154, 58, .34);
    --uckk-gold-border: rgba(196, 154, 58, .48);
    --uckk-ink: #102724;
    --uckk-muted: #52615d;
}

/* Base page: remove Boost white seams and accidental pale gradients. */
html,
body,
#page-wrapper,
#page,
#page.drawers,
#page-content,
#region-main,
#region-main-box,
#region-main-settings-menu,
.main-inner,
.drawer,
.drawercontent,
.drawer-toggles .drawer-toggler,
.pagelayout-admin #page,
.path-admin #page,
.path-course-management #page,
.path-course #page,
.path-course #region-main {
    background-image: none !important;
    background-color: var(--uckk-paper) !important;
    color: var(--uckk-ink);
}

/* Main Moodle content sheet. */
.main-inner,
#region-main {
    background: var(--uckk-paper-soft) !important;
    border: 1px solid var(--uckk-gold-soft);
    box-shadow: 0 .75rem 2rem rgba(5, 47, 45, .08);
}

/* Top navbar: flat petrol, poster-like, no gradient. */
.navbar.fixed-top,
.navbar-light,
.moremenu,
.secondary-navigation,
.activity-navigation {
    background-image: none !important;
    background-color: var(--uckk-petrol-deep) !important;
    border-bottom: 2px solid var(--uckk-gold);
    color: var(--uckk-paper-soft);
}

.navbar.fixed-top .navbar-brand,
.navbar.fixed-top .nav-link,
.navbar.fixed-top .login,
.navbar.fixed-top a,
.navbar.fixed-top .usertext,
.moremenu .nav-link,
.secondary-navigation .nav-link,
.activity-navigation .nav-link {
    color: var(--uckk-paper-soft) !important;
}

.navbar.fixed-top .nav-link.active,
.moremenu .nav-link.active,
.secondary-navigation .nav-link.active,
.activity-navigation .nav-link.active {
    background: rgba(196, 154, 58, .18) !important;
    color: var(--uckk-paper-soft) !important;
    border-bottom-color: var(--uckk-gold) !important;
}

/* Keep avatar/menu readable on petrol nav. */
.navbar.fixed-top .userinitials,
.navbar.fixed-top .popover-region-toggle,
.navbar.fixed-top .icon {
    color: var(--uckk-paper-soft) !important;
}

/* Page header: parchment, not white. */
#page-header,
.page-context-header,
.page-header-headings {
    background-image: none !important;
    background-color: var(--uckk-paper-soft) !important;
    color: var(--uckk-ink);
}

#page-header {
    border-bottom: 1px solid var(--uckk-gold-soft);
}

/* Headings: institutional/poster tone. */
h1,
h2,
h3,
.page-header-headings h1,
#region-main h2 {
    color: var(--uckk-ink);
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 800;
    letter-spacing: .035em;
}

/* Links. */
a,
a:visited,
.btn-link {
    color: var(--uckk-petrol) !important;
}

a:hover,
.btn-link:hover {
    color: var(--uckk-petrol-dark) !important;
}

/* Buttons. */
.btn-primary,
.btn-secondary,
.btn-outline-primary:hover,
input[type="submit"],
button[type="submit"] {
    background-image: none !important;
    background-color: var(--uckk-petrol) !important;
    border-color: var(--uckk-petrol-dark) !important;
    color: var(--uckk-paper-soft) !important;
    box-shadow: none !important;
}

.btn-primary:hover,
.btn-secondary:hover,
input[type="submit"]:hover,
button[type="submit"]:hover {
    background-color: var(--uckk-petrol-dark) !important;
    border-color: var(--uckk-gold) !important;
}

/* Cards, admin boxes, course category panels. */
.card,
.box,
.generalbox,
.adminsettings,
.settingsform,
.category-listing,
.course-listing,
.coursecat-management,
.course_category_tree,
.course_category_tree .category,
.course_category_tree .content,
.coursebox,
.path-course-management .category,
.path-course-management .course-listing,
.path-course-management .category-listing,
.path-admin .form-item,
.path-admin .form-group,
.path-admin .settingsform {
    background-image: none !important;
    background-color: var(--uckk-paper-soft) !important;
    border-color: var(--uckk-gold-soft) !important;
    color: var(--uckk-ink);
}

/* Course/category management rows. */
.course_category_tree .category > .info,
.course_category_tree .courses .coursebox,
.path-course-management .listitem,
.path-course-management .listing-actions,
.path-course-management .item-actions,
.path-course-management .category-item,
.path-course-management .course-listitem,
.path-course-management .category-listitem {
    background-image: none !important;
    background-color: var(--uckk-paper) !important;
    border-color: rgba(196, 154, 58, .28) !important;
}

/* Poster-style left rule. */
.course_category_tree,
.coursecat-management,
.path-course-management .category-listing,
#region-main > .box,
#region-main > .generalbox {
    border-left: .35rem solid var(--uckk-petrol) !important;
}

/* Tables. */
table,
.generaltable,
table.collection,
.table {
    background: var(--uckk-paper-soft) !important;
    color: var(--uckk-ink);
    border-color: var(--uckk-gold-soft) !important;
}

.generaltable th,
.table th,
thead th {
    background-image: none !important;
    background-color: var(--uckk-petrol-deep) !important;
    color: var(--uckk-paper-soft) !important;
    border-color: var(--uckk-gold) !important;
}

.generaltable td,
.table td,
tbody td {
    background-color: var(--uckk-paper-soft) !important;
    border-color: rgba(196, 154, 58, .24) !important;
}

/* Tabs. */
.nav-tabs,
.nav-tabs .nav-link,
.nav-tabs .nav-item.show .nav-link {
    border-color: var(--uckk-gold-soft) !important;
}

.nav-tabs .nav-link {
    background: var(--uckk-paper) !important;
    color: var(--uckk-petrol) !important;
}

.nav-tabs .nav-link.active {
    background: var(--uckk-paper-soft) !important;
    color: var(--uckk-ink) !important;
    border-top: 3px solid var(--uckk-petrol) !important;
}

/* Forms. */
.form-control,
.custom-select,
select,
input[type="text"],
input[type="search"],
textarea {
    background: var(--uckk-paper-soft) !important;
    color: var(--uckk-ink) !important;
    border-color: rgba(16, 39, 36, .28) !important;
}

.form-control:focus,
.custom-select:focus,
select:focus,
input[type="text"]:focus,
input[type="search"]:focus,
textarea:focus {
    border-color: var(--uckk-petrol) !important;
    box-shadow: 0 0 0 .2rem rgba(30, 104, 100, .16) !important;
}

/* Dropdowns, popovers, modals. */
.dropdown-menu,
.popover,
.modal-content {
    background: var(--uckk-paper-soft) !important;
    border: 1px solid var(--uckk-gold-soft) !important;
    color: var(--uckk-ink);
}

.dropdown-item:hover,
.dropdown-item:focus {
    background: rgba(30, 104, 100, .1) !important;
    color: var(--uckk-ink) !important;
}

/* Breadcrumb and small navigation details. */
.breadcrumb,
.breadcrumb-item,
.breadcrumb-item a {
    background: transparent !important;
    color: var(--uckk-petrol) !important;
}

.breadcrumb-item.active {
    color: var(--uckk-muted) !important;
}

/* Poster-like section dividers. */
hr,
.dropdown-divider {
    border-top-color: var(--uckk-gold-soft) !important;
}

/* ==========================================================================
   UCKK header branding and gradient cleanup
   Runtime image files required in theme_uckk/pix:
   - LogoUCKK_64px.png
   - LogoUCKK_256px.png
   - LogoUCKK_720W.png
   ========================================================================== */

/* Header brand: use the sharper 720W logo source and the full institutional name. */
.navbar.fixed-top .navbar-brand {
    display: inline-flex !important;
    align-items: center;
    gap: .65rem;
    min-width: 18rem;
    min-height: 3rem;
    padding-inline: .35rem .75rem;
    color: transparent !important;
    font-size: 0 !important;
    line-height: 1;
    text-decoration: none;
}

.navbar.fixed-top .navbar-brand::before {
    content: "";
    display: inline-block;
    width: 4.2rem;
    height: 2.9rem;
    flex: 0 0 auto;
    background-image: url([[pix:theme_uckk|LogoUCKK_720W]]);
    background-repeat: no-repeat;
    background-position: center left;
    background-size: contain;
}

.navbar.fixed-top .navbar-brand::after {
    content: "Univers-cité King Klown";
    display: inline-block;
    color: var(--uckk-paper-soft);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.02rem;
    font-weight: 700;
    letter-spacing: .03em;
    white-space: nowrap;
    text-shadow: 0 1px 0 rgba(196, 154, 58, .35);
}

.navbar.fixed-top .navbar-brand:hover::after,
.navbar.fixed-top .navbar-brand:focus::after {
    color: var(--uckk-gold);
}

/* Keep the Moodle navbar logo image hidden so our sharper source is used. */
.navbar.fixed-top .navbar-brand img,
.navbar.fixed-top .navbar-brand picture {
    display: none !important;
}

/* Stronger dashboard and admin overrides to kill lingering green-gold gradients. */
body.path-my #page-header,
body.path-my #page-header *,
body.path-my .block,
body.path-my .card,
body.path-my .dashboard-card,
body.path-my .main-inner,
body.path-admin #page-header,
body.path-admin .block,
body.path-admin .card,
body.path-course-management #page-header,
body.path-course-management .card {
    background-image: none !important;
}

body.path-my #page-header,
body.path-admin #page-header,
body.path-course-management #page-header {
    background-color: var(--uckk-paper-soft) !important;
    border-left: .35rem solid var(--uckk-petrol) !important;
}

body.path-my #page-header::before,
body.path-my #page-header::after,
body.path-admin #page-header::before,
body.path-admin #page-header::after,
body.path-course-management #page-header::before,
body.path-course-management #page-header::after {
    background-image: none !important;
}

/* Re-apply the quiet watermark after the gradient reset. */
body.path-my #page-header::after,
body.path-admin #page-header::after,
body.path-course-management #page-header::after {
    content: "";
    position: absolute;
    right: 1.25rem;
    bottom: -.75rem;
    width: clamp(6rem, 16vw, 12rem);
    aspect-ratio: 1;
    pointer-events: none;
    opacity: .075;
    background-image: url([[pix:theme_uckk|LogoUCKK_256px]]) !important;
    background-repeat: no-repeat;
    background-position: center;
    background-size: contain;
}

/* Front page hero crest. */
.theme-uckk-frontpage__hero-content::before {
    content: "";
    display: block;
    width: min(28rem, 72vw);
    aspect-ratio: 720 / 546;
    margin: 0 0 1.5rem;
    background-image: url([[pix:theme_uckk|LogoUCKK_720W]]);
    background-repeat: no-repeat;
    background-position: left center;
    background-size: contain;
    filter: drop-shadow(0 .35rem .75rem rgba(0, 0, 0, .28));
}

/* Mobile: keep only the logo graphic, hide long text. */
@media (max-width: 767.98px) {
    .navbar.fixed-top .navbar-brand {
        min-width: 3.5rem;
        padding-inline: .25rem;
    }

    .navbar.fixed-top .navbar-brand::before {
        width: 3rem;
        height: 2.25rem;
    }

    .navbar.fixed-top .navbar-brand::after {
        display: none;
    }

    body.path-my #page-header::after,
    body.path-admin #page-header::after,
    body.path-course-management #page-header::after {
        display: none;
    }

    .theme-uckk-frontpage__hero-content::before {
        width: min(18rem, 80vw);
        margin-bottom: 1rem;
    }
}

/* ========================================================================== 
   Accessibility and motion preferences
   ========================================================================== */

.theme-uckk-frontpage a:focus-visible,
.theme-uckk-frontpage button:focus-visible,
.theme-uckk-dashboard-card a:focus-visible,
.theme-uckk-dashboard-card button:focus-visible {
    @include theme-uckk-focus-ring;
}

@media (prefers-reduced-motion: reduce) {
    .theme-uckk-frontpage *,
    .theme-uckk-dashboard-card *,
    .theme-uckk-surface,
    .theme-uckk-surface-dark {
        transition: none !important;
        animation: none !important;
        scroll-behavior: auto !important;
    }

    .theme-uckk-frontpage__card:hover,
    .theme-uckk-frontpage__card:focus-within {
        transform: none;
    }
}

@media (forced-colors: active) {
    .theme-uckk-frontpage__card,
    .theme-uckk-frontpage__boundary,
    .theme-uckk-frontpage__notice,
    .theme-uckk-dashboard-card {
        border: 1px solid CanvasText;
        box-shadow: none;
    }

    .theme-uckk-frontpage__hero {
        background: Canvas;
        color: CanvasText;
    }
}

/* ========================================================================== 
   Responsive layout for UCKK-owned components
   ========================================================================== */

@media (max-width: 1199.98px) {
    .theme-uckk-frontpage__cards {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .theme-uckk-frontpage__boundary-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 991.98px) {
    .theme-uckk-frontpage__hero {
        padding: 4rem 0 3rem;
    }

    .theme-uckk-frontpage__hero-grid {
        grid-template-columns: 1fr;
    }

    .theme-uckk-frontpage__hero-panel {
        max-width: 42rem;
    }
}

@media (max-width: 767.98px) {
    .theme-uckk-frontpage {
        background:
            radial-gradient(circle at 30% 0%, rgba(185, 147, 75, .22), transparent 20rem),
            linear-gradient(180deg, var(--uckk-ink) 0%, var(--uckk-petrol) 32rem, var(--uckk-paper) 32rem);
    }

    .theme-uckk-frontpage__hero {
        padding: 3rem 0 2.5rem;
    }

    .theme-uckk-frontpage__title {
        letter-spacing: -.04em;
    }

    .theme-uckk-frontpage__actions {
        flex-direction: column;
        align-items: stretch;
    }

    .theme-uckk-frontpage__primary-action,
    .theme-uckk-frontpage__secondary-action {
        width: 100%;
    }

    .theme-uckk-frontpage__main {
        padding: 3rem 0 4rem;
    }

    .theme-uckk-frontpage__cards,
    .theme-uckk-frontpage__boundary-grid {
        grid-template-columns: 1fr;
    }

    .theme-uckk-frontpage__notice {
        grid-template-columns: 1fr;
    }

    .theme-uckk-frontpage__notice-icon {
        width: 2.5rem;
        height: 2.5rem;
    }
}

@media (max-width: 575.98px) {
    .theme-uckk-frontpage__seal {
        align-items: flex-start;
        border-radius: var(--uckk-radius);
    }

    .theme-uckk-frontpage__formula-card,
    .theme-uckk-frontpage__boundary {
        padding: 1.25rem;
        border-radius: var(--uckk-radius-lg);
    }

    .theme-uckk-frontpage__card {
        min-height: auto;
    }
}

/* ========================================================================== 
   Print
   ========================================================================== */

@media print {
    .theme-uckk-frontpage {
        background: #fff !important;
        color: #000 !important;
    }

    .theme-uckk-frontpage__hero,
    .theme-uckk-frontpage__main,
    .theme-uckk-frontpage__boundary,
    .theme-uckk-frontpage__notice,
    .theme-uckk-frontpage__card {
        background: #fff !important;
        color: #000 !important;
        box-shadow: none !important;
    }

    .theme-uckk-frontpage__actions,
    .theme-uckk-frontpage__card-link {
        display: none !important;
    }
}
