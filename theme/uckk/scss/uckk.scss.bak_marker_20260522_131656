/**
 * UCKK theme main SCSS.
 *
 * This file defines the visual identity layer for UCKK-Moodle.
 *
 * It styles only UCKK-owned templates and shared UCKK interface patterns.
 * It must not take ownership of Moodle/Boost page layout, drawers, navigation,
 * course editing controls, grading UI, permissions, workflow state, or data logic.
 *
 * @package    theme_uckk
 * @copyright  2026 UCKK
 * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
 */

/* ========================================================================== 
   UCKK brand tokens
   ========================================================================== */

$theme-uckk-black: #0b0b0f !default;
$theme-uckk-black-soft: #15151c !default;
$theme-uckk-ivory: #f7f1df !default;
$theme-uckk-ivory-muted: #eee3c8 !default;
$theme-uckk-red: #b32222 !default;
$theme-uckk-red-dark: #7f1717 !default;
$theme-uckk-gold: #b9934b !default;
$theme-uckk-gold-soft: #d2b574 !default;
$theme-uckk-blue: #121a3a !default;
$theme-uckk-blue-soft: #1e2a54 !default;
$theme-uckk-green: #84b84a !default;
$theme-uckk-green-soft: #dcecc4 !default;
$theme-uckk-white: #fff !default;
$theme-uckk-grey-100: #f7f7f8 !default;
$theme-uckk-grey-200: #ececf0 !default;
$theme-uckk-grey-300: #d6d8df !default;
$theme-uckk-grey-600: #606477 !default;
$theme-uckk-grey-800: #252735 !default;

$theme-uckk-radius-sm: .375rem !default;
$theme-uckk-radius: .75rem !default;
$theme-uckk-radius-lg: 1.25rem !default;
$theme-uckk-radius-xl: 2rem !default;

$theme-uckk-shadow-sm: 0 .25rem .75rem rgba(11, 11, 15, .12) !default;
$theme-uckk-shadow: 0 1rem 2.5rem rgba(11, 11, 15, .18) !default;
$theme-uckk-shadow-lg: 0 2rem 4rem rgba(11, 11, 15, .28) !default;

$theme-uckk-border-soft: 1px solid rgba(255, 255, 255, .18) !default;
$theme-uckk-border-dark: 1px solid rgba(11, 11, 15, .12) !default;

$theme-uckk-transition: 160ms ease-in-out !default;

/* ========================================================================== 
   Mixins
   ========================================================================== */

@mixin theme-uckk-eyebrow-text {
    color: var(--uckk-gold);
    font-size: .765625rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
}

@mixin theme-uckk-focus-ring {
    outline: .1875rem solid var(--uckk-gold);
    outline-offset: .1875rem;
}

/* ========================================================================== 
   CSS custom properties
   ========================================================================== */

:root {
    --uckk-black: #{$theme-uckk-black};
    --uckk-black-soft: #{$theme-uckk-black-soft};
    --uckk-ivory: #{$theme-uckk-ivory};
    --uckk-ivory-muted: #{$theme-uckk-ivory-muted};
    --uckk-red: #{$theme-uckk-red};
    --uckk-red-dark: #{$theme-uckk-red-dark};
    --uckk-gold: #{$theme-uckk-gold};
    --uckk-gold-soft: #{$theme-uckk-gold-soft};
    --uckk-blue: #{$theme-uckk-blue};
    --uckk-blue-soft: #{$theme-uckk-blue-soft};
    --uckk-green: #{$theme-uckk-green};
    --uckk-green-soft: #{$theme-uckk-green-soft};
    --uckk-white: #{$theme-uckk-white};
    --uckk-grey-100: #{$theme-uckk-grey-100};
    --uckk-grey-200: #{$theme-uckk-grey-200};
    --uckk-grey-300: #{$theme-uckk-grey-300};
    --uckk-grey-600: #{$theme-uckk-grey-600};
    --uckk-grey-800: #{$theme-uckk-grey-800};
    --uckk-radius-sm: #{$theme-uckk-radius-sm};
    --uckk-radius: #{$theme-uckk-radius};
    --uckk-radius-lg: #{$theme-uckk-radius-lg};
    --uckk-radius-xl: #{$theme-uckk-radius-xl};
    --uckk-shadow-sm: #{$theme-uckk-shadow-sm};
    --uckk-shadow: #{$theme-uckk-shadow};
    --uckk-shadow-lg: #{$theme-uckk-shadow-lg};
}

/* ========================================================================== 
   Shared UCKK components
   ========================================================================== */

.theme-uckk-surface {
    background: var(--uckk-white);
    border: $theme-uckk-border-dark;
    border-radius: var(--uckk-radius);
    box-shadow: var(--uckk-shadow-sm);
}

.theme-uckk-surface-dark {
    background: linear-gradient(135deg, var(--uckk-black), var(--uckk-blue));
    color: var(--uckk-ivory);
    border: $theme-uckk-border-soft;
    border-radius: var(--uckk-radius);
    box-shadow: var(--uckk-shadow);
}

.theme-uckk-eyebrow {
    @include theme-uckk-eyebrow-text;
}

.theme-uckk-muted {
    color: var(--uckk-grey-600);
}

.theme-uckk-divider {
    width: 100%;
    height: 1px;
    margin: 1.5rem 0;
    background: linear-gradient(
        90deg,
        transparent,
        rgba(185, 147, 75, .5),
        transparent
    );
}

.theme-uckk-focus-ring:focus,
.theme-uckk-focus-ring:focus-visible {
    @include theme-uckk-focus-ring;
}

/* ========================================================================== 
   Front page component
   ========================================================================== */

.theme-uckk-frontpage {
    background:
        radial-gradient(circle at 15% 0%, rgba(185, 147, 75, .2), transparent 28rem),
        radial-gradient(circle at 85% 10%, rgba(132, 184, 74, .13), transparent 24rem),
        linear-gradient(180deg, var(--uckk-black) 0%, var(--uckk-blue) 36rem, var(--uckk-ivory) 36rem);
    color: var(--uckk-black);
    overflow: hidden;

    .btn-primary {
        background: var(--uckk-red);
        border-color: var(--uckk-red);
        color: var(--uckk-white);
        box-shadow: 0 .5rem 1.25rem rgba(179, 34, 34, .28);

        &:hover,
        &:focus {
            background: var(--uckk-red-dark);
            border-color: var(--uckk-red-dark);
            color: var(--uckk-white);
            box-shadow: 0 .75rem 1.75rem rgba(179, 34, 34, .35);
        }
    }

    .btn-outline-primary {
        border-color: var(--uckk-gold);
        color: var(--uckk-ivory);

        &:hover,
        &:focus {
            background: var(--uckk-gold);
            border-color: var(--uckk-gold);
            color: var(--uckk-black);
        }
    }

    .btn-outline-secondary {
        border-color: rgba(11, 11, 15, .4);
        color: var(--uckk-black);

        &:hover,
        &:focus {
            background: var(--uckk-black);
            border-color: var(--uckk-black);
            color: var(--uckk-white);
        }
    }

    a {
        transition:
            color $theme-uckk-transition,
            background-color $theme-uckk-transition,
            border-color $theme-uckk-transition,
            box-shadow $theme-uckk-transition,
            transform $theme-uckk-transition;
    }
}

.theme-uckk-frontpage__hero {
    position: relative;
    color: var(--uckk-ivory);
    padding: 5rem 0 4rem;

    &::before {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        opacity: .16;
        background-image:
            linear-gradient(rgba(255, 255, 255, .15) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255, 255, 255, .15) 1px, transparent 1px);
        background-size: 4rem 4rem;
        mask-image: linear-gradient(180deg, #000, transparent 92%);
        -webkit-mask-image: linear-gradient(180deg, #000, transparent 92%);
    }
}

.theme-uckk-frontpage__hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(18rem, .75fr);
    gap: 2rem;
    align-items: center;
}

.theme-uckk-frontpage__hero-content {
    max-width: 48rem;
}

.theme-uckk-frontpage__seal {
    display: inline-flex;
    align-items: center;
    gap: .75rem;
    max-width: 100%;
    margin-bottom: 1.5rem;
    padding: .625rem .875rem;
    background: rgba(255, 255, 255, .08);
    border: $theme-uckk-border-soft;
    border-radius: 999rem;
}

@supports (backdrop-filter: blur(.5rem)) or (-webkit-backdrop-filter: blur(.5rem)) {
    .theme-uckk-frontpage__seal,
    .theme-uckk-frontpage__formula-card {
        backdrop-filter: blur(.5rem);
        -webkit-backdrop-filter: blur(.5rem);
    }

    .theme-uckk-frontpage__formula-card {
        backdrop-filter: blur(.75rem);
        -webkit-backdrop-filter: blur(.75rem);
    }
}

.theme-uckk-frontpage__seal-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    flex: 0 0 auto;

    img,
    svg {
        max-width: 100%;
        height: auto;
    }
}

.theme-uckk-frontpage__seal-text {
    color: var(--uckk-ivory-muted);
    font-size: .875rem;
    font-weight: 700;
    letter-spacing: .04em;
}

.theme-uckk-frontpage__eyebrow {
    @include theme-uckk-eyebrow-text;
    margin-bottom: .75rem;
}

.theme-uckk-frontpage__title {
    margin: 0 0 1rem;
    color: var(--uckk-white);
    font-size: clamp(2.5rem, 6vw, 5.75rem);
    font-weight: 800;
    line-height: .95;
    letter-spacing: -.06em;
    text-wrap: balance;
}

.theme-uckk-frontpage__subtitle {
    max-width: 43rem;
    margin: 0 0 1rem;
    color: var(--uckk-ivory);
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    line-height: 1.5;
}

.theme-uckk-frontpage__slogan {
    max-width: 40rem;
    margin: 0 0 2rem;
    color: var(--uckk-gold-soft);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: .03em;
}

.theme-uckk-frontpage__actions {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem;
}

.theme-uckk-frontpage__primary-action,
.theme-uckk-frontpage__secondary-action {
    border-radius: 999rem;
    font-weight: 700;
}

.theme-uckk-frontpage__hero-panel {
    align-self: stretch;
}

.theme-uckk-frontpage__formula-card {
    position: relative;
    height: 100%;
    padding: 2rem;
    background:
        linear-gradient(145deg, rgba(255, 255, 255, .12), rgba(255, 255, 255, .04)),
        linear-gradient(180deg, rgba(185, 147, 75, .22), rgba(11, 11, 15, .28));
    border: $theme-uckk-border-soft;
    border-radius: var(--uckk-radius-xl);
    box-shadow: var(--uckk-shadow-lg);

    &::after {
        content: "";
        position: absolute;
        inset: 1rem;
        pointer-events: none;
        border: 1px solid rgba(185, 147, 75, .28);
        border-radius: calc(var(--uckk-radius-xl) - .5rem);
    }
}

.theme-uckk-frontpage__formula-title {
    position: relative;
    z-index: 1;
    margin: 0 0 1.5rem;
    color: var(--uckk-gold-soft);
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: .04em;
    text-transform: uppercase;
}

.theme-uckk-frontpage__formula-list {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;

    li {
        padding-left: 1.35rem;
        color: var(--uckk-ivory);
        font-size: 1rem;
        line-height: 1.45;

        &::before {
            content: "◆";
            display: inline-block;
            width: 1.35rem;
            margin-left: -1.35rem;
            color: var(--uckk-red);
            font-size: .75rem;
            vertical-align: .1rem;
        }
    }
}

.theme-uckk-frontpage__formula-footer {
    position: relative;
    z-index: 1;
    margin: 1.5rem 0 0;
    color: var(--uckk-ivory-muted);
    font-size: .9375rem;
    line-height: 1.5;
}

.theme-uckk-frontpage__main {
    position: relative;
    padding: 4rem 0 5rem;
    background: var(--uckk-ivory);
}

.theme-uckk-frontpage__section-intro {
    max-width: 60rem;
    margin-bottom: 2rem;
}

.theme-uckk-frontpage__section-label {
    @include theme-uckk-eyebrow-text;
    color: var(--uckk-red);
    margin-bottom: .5rem;
}

.theme-uckk-frontpage__section-title {
    margin: 0;
    color: var(--uckk-black);
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -.03em;
    text-wrap: balance;
}

.theme-uckk-frontpage__cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    margin-bottom: 3rem;
}

.theme-uckk-frontpage__card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 18rem;
    padding: 1.5rem;
    background: var(--uckk-white);
    border: $theme-uckk-border-dark;
    border-radius: var(--uckk-radius-lg);
    box-shadow: var(--uckk-shadow-sm);
    transition:
        transform $theme-uckk-transition,
        box-shadow $theme-uckk-transition,
        border-color $theme-uckk-transition;

    &:hover,
    &:focus-within {
        transform: translateY(-.25rem);
        border-color: rgba(185, 147, 75, .5);
        box-shadow: var(--uckk-shadow);
    }
}

.theme-uckk-frontpage__card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    margin-bottom: 1rem;
    background: rgba(185, 147, 75, .15);
    border-radius: 999rem;

    img,
    svg {
        max-width: 1.75rem;
        height: auto;
    }
}

.theme-uckk-frontpage__card-title {
    margin: 0 0 .75rem;
    color: var(--uckk-black);
    font-size: 1.25rem;
    font-weight: 800;
    line-height: 1.2;
}

.theme-uckk-frontpage__card-text {
    flex: 1 1 auto;
    margin: 0 0 1rem;
    color: var(--uckk-grey-600);
    line-height: 1.55;
}

.theme-uckk-frontpage__card-link {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    align-self: flex-start;
    margin-top: auto;
    color: var(--uckk-red);
    font-weight: 700;
    text-decoration: none;

    &::after {
        content: "→";
        transition: transform $theme-uckk-transition;
    }

    &:hover,
    &:focus {
        color: var(--uckk-red-dark);
        text-decoration: underline;

        &::after {
            transform: translateX(.2rem);
        }
    }
}

/* ========================================================================== 
   Boundary and notice components
   ========================================================================== */

.theme-uckk-frontpage__boundary {
    margin: 0 0 2rem;
    padding: 2rem;
    background:
        linear-gradient(135deg, rgba(18, 26, 58, .98), rgba(11, 11, 15, .98)),
        var(--uckk-blue);
    color: var(--uckk-ivory);
    border-radius: var(--uckk-radius-xl);
    box-shadow: var(--uckk-shadow);
}

.theme-uckk-frontpage__boundary-title {
    margin: 0 0 1.25rem;
    color: var(--uckk-gold-soft);
    font-size: 1.375rem;
    font-weight: 800;
}

.theme-uckk-frontpage__boundary-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: .875rem;
}

.theme-uckk-frontpage__boundary-item {
    display: grid;
    gap: .35rem;
    padding: 1rem;
    background: rgba(255, 255, 255, .08);
    border: $theme-uckk-border-soft;
    border-radius: var(--uckk-radius);

    strong {
        color: var(--uckk-white);
        font-size: .9375rem;
    }

    span {
        color: var(--uckk-ivory-muted);
        font-size: .875rem;
        line-height: 1.45;
    }
}

.theme-uckk-frontpage__notices {
    display: grid;
    gap: 1rem;
}

.theme-uckk-frontpage__notice {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    padding: 1.25rem;
    background: var(--uckk-white);
    border: $theme-uckk-border-dark;
    border-radius: var(--uckk-radius-lg);
    box-shadow: var(--uckk-shadow-sm);
}

.theme-uckk-frontpage__notice-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    background: var(--uckk-grey-100);
    border-radius: 999rem;

    img,
    svg {
        max-width: 1.75rem;
        height: auto;
    }
}

.theme-uckk-frontpage__notice-content {
    min-width: 0;

    p {
        margin: 0 0 .75rem;
        color: var(--uckk-grey-800);
        line-height: 1.55;

        &:last-child {
            margin-bottom: 0;
        }
    }
}

.theme-uckk-frontpage__notice-title {
    margin: 0 0 .625rem;
    color: var(--uckk-black);
    font-size: 1.125rem;
    font-weight: 800;
}

.theme-uckk-frontpage__notice-emphasis {
    font-weight: 700;
}

.theme-uckk-frontpage__notice--integrity {
    border-left: .375rem solid var(--uckk-red);

    .theme-uckk-frontpage__notice-icon {
        background: rgba(179, 34, 34, .12);
    }
}

.theme-uckk-frontpage__notice--ai {
    grid-template-columns: minmax(0, 1fr);
    border-left: .375rem solid var(--uckk-green);
    background: linear-gradient(135deg, var(--uckk-green-soft), var(--uckk-white));
}

.theme-uckk-frontpage__notice--recognition {
    grid-template-columns: minmax(0, 1fr);
    border-left: .375rem solid var(--uckk-gold);
}

/* ========================================================================== 
   UCKK badges and markers
   ========================================================================== */

.theme-uckk-status,
.theme-uckk-visibility,
.theme-uckk-marker {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    padding: .25rem .55rem;
    border-radius: 999rem;
    font-size: .75rem;
    font-weight: 700;
    line-height: 1.2;
    white-space: nowrap;
}

.theme-uckk-status {
    background: var(--uckk-grey-200);
    color: var(--uckk-grey-800);
}

.theme-uckk-status--validated {
    background: var(--uckk-green-soft);
    color: #2f5b20;
}

.theme-uckk-status--contested,
.theme-uckk-status--correctionrequired {
    background: rgba(185, 147, 75, .18);
    color: #6b4d13;
}

.theme-uckk-status--invalidated {
    background: rgba(179, 34, 34, .12);
    color: var(--uckk-red-dark);
}

.theme-uckk-status--archived {
    background: rgba(18, 26, 58, .12);
    color: var(--uckk-blue);
}

.theme-uckk-visibility {
    background: rgba(18, 26, 58, .08);
    color: var(--uckk-blue);
}

.theme-uckk-marker--ai {
    background: var(--uckk-green-soft);
    color: #2f5b20;
}

.theme-uckk-marker--integrity {
    background: rgba(179, 34, 34, .12);
    color: var(--uckk-red-dark);
}

.theme-uckk-marker--archive {
    background: rgba(185, 147, 75, .18);
    color: #6b4d13;
}

/* ========================================================================== 
   Dashboard/card components
   ========================================================================== */

.theme-uckk-dashboard-shell {
    display: grid;
    gap: 1rem;
}

.theme-uckk-dashboard-card {
    padding: 1.25rem;
    background: var(--uckk-white);
    border: $theme-uckk-border-dark;
    border-radius: var(--uckk-radius-lg);
    box-shadow: var(--uckk-shadow-sm);
}

.theme-uckk-dashboard-card__title {
    margin: 0 0 .75rem;
    color: var(--uckk-black);
    font-size: 1.125rem;
    font-weight: 800;
}

.theme-uckk-dashboard-card__meta {
    color: var(--uckk-grey-600);
    font-size: .875rem;
}

.theme-uckk-progress-line {
    overflow: hidden;
    height: .625rem;
    background: var(--uckk-grey-200);
    border-radius: 999rem;
}

.theme-uckk-progress-line__bar {
    min-width: .25rem;
    height: 100%;
    background: linear-gradient(90deg, var(--uckk-red), var(--uckk-gold));
    border-radius: inherit;
}

/* ========================================================================== 
   Accessibility and motion preferences
   ========================================================================== */

.theme-uckk-frontpage a:focus-visible,
.theme-uckk-frontpage button:focus-visible,
.theme-uckk-dashboard-card a:focus-visible,
.theme-uckk-dashboard-card button:focus-visible {
    @include theme-uckk-focus-ring;
}

@media (prefers-reduced-motion: reduce) {
    .theme-uckk-frontpage *,
    .theme-uckk-dashboard-card *,
    .theme-uckk-surface,
    .theme-uckk-surface-dark {
        transition: none !important;
        animation: none !important;
        scroll-behavior: auto !important;
    }

    .theme-uckk-frontpage__card:hover,
    .theme-uckk-frontpage__card:focus-within {
        transform: none;
    }
}

@media (forced-colors: active) {
    .theme-uckk-frontpage__card,
    .theme-uckk-frontpage__boundary,
    .theme-uckk-frontpage__notice,
    .theme-uckk-dashboard-card {
        border: 1px solid CanvasText;
        box-shadow: none;
    }

    .theme-uckk-frontpage__hero {
        background: Canvas;
        color: CanvasText;
    }
}

/* ========================================================================== 
   Responsive layout for UCKK-owned components
   ========================================================================== */

@media (max-width: 1199.98px) {
    .theme-uckk-frontpage__cards {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .theme-uckk-frontpage__boundary-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 991.98px) {
    .theme-uckk-frontpage__hero {
        padding: 4rem 0 3rem;
    }

    .theme-uckk-frontpage__hero-grid {
        grid-template-columns: 1fr;
    }

    .theme-uckk-frontpage__hero-panel {
        max-width: 42rem;
    }
}

@media (max-width: 767.98px) {
    .theme-uckk-frontpage {
        background:
            radial-gradient(circle at 30% 0%, rgba(185, 147, 75, .22), transparent 20rem),
            linear-gradient(180deg, var(--uckk-black) 0%, var(--uckk-blue) 32rem, var(--uckk-ivory) 32rem);
    }

    .theme-uckk-frontpage__hero {
        padding: 3rem 0 2.5rem;
    }

    .theme-uckk-frontpage__title {
        letter-spacing: -.04em;
    }

    .theme-uckk-frontpage__actions {
        flex-direction: column;
        align-items: stretch;
    }

    .theme-uckk-frontpage__primary-action,
    .theme-uckk-frontpage__secondary-action {
        width: 100%;
    }

    .theme-uckk-frontpage__main {
        padding: 3rem 0 4rem;
    }

    .theme-uckk-frontpage__cards,
    .theme-uckk-frontpage__boundary-grid {
        grid-template-columns: 1fr;
    }

    .theme-uckk-frontpage__notice {
        grid-template-columns: 1fr;
    }

    .theme-uckk-frontpage__notice-icon {
        width: 2.5rem;
        height: 2.5rem;
    }
}

@media (max-width: 575.98px) {
    .theme-uckk-frontpage__seal {
        align-items: flex-start;
        border-radius: var(--uckk-radius);
    }

    .theme-uckk-frontpage__formula-card,
    .theme-uckk-frontpage__boundary {
        padding: 1.25rem;
        border-radius: var(--uckk-radius-lg);
    }

    .theme-uckk-frontpage__card {
        min-height: auto;
    }
}

/* ========================================================================== 
   Print
   ========================================================================== */

@media print {
    .theme-uckk-frontpage {
        background: #fff !important;
        color: #000 !important;
    }

    .theme-uckk-frontpage__hero,
    .theme-uckk-frontpage__main,
    .theme-uckk-frontpage__boundary,
    .theme-uckk-frontpage__notice,
    .theme-uckk-frontpage__card {
        background: #fff !important;
        color: #000 !important;
        box-shadow: none !important;
    }

    .theme-uckk-frontpage__actions,
    .theme-uckk-frontpage__card-link {
        display: none !important;
    }
}
