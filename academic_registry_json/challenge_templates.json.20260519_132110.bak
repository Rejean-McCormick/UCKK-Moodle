    {
      "key": "internal_learning",
      "name": "Défi d’apprentissage interne",
      "component": "mod_uckkchallenge",
      "description": "Template de défi pour apprentissage interne, production de preuve, rétroaction mentorale et archive pédagogique.",
      "defaults": {
        "challenge_type": "internal_learning",
        "status": "draft",
        "visibility": "course",
        "provenance": "system",
        "validationstate": "unverified",
        "requires_human_validation": true,
        "allow_ai_assistance": true,
        "allow_ai_decision": false,
        "archive_required": true,
        "integrity_review_required": false,
        "estimated_duration": "2 weeks",
        "participant_roles": [
          "uckkplayer",
          "uckkmentor"
        ],
        "statement": "Produire une preuve d’apprentissage située, vérifiable et révisable.",
        "context": "Cours UCKK ou parcours du tronc commun.",
        "rules": [
          "La preuve doit être liée à une compétence UCKK.",
          "La provenance doit être déclarée.",
          "Toute aide IA doit être journalisée.",
          "La validation finale reste humaine."
        ],
        "corridors_of_action": [
          "analyse",
          "production",
          "révision",
          "archive"
        ],
        "evidence_requirements": [
          {
            "type": "text",
            "required": true,
            "label": "Réflexion structurée"
          },
          {
            "type": "file",
            "required": false,
            "label": "Artefact ou livrable"
          },
          {
            "type": "ai_log",
            "required": false,
            "label": "Journal de collaboration IA"
          }
        ],
        "evaluation_criteria": [
          {
            "key": "clarity",
            "label": "Clarté de la preuve",
            "maxscore": 25,
            "required": true
          },
          {
            "key": "competency_alignment",
            "label": "Alignement avec les compétences",
            "maxscore": 25,
            "required": true
          },
          {
            "key": "provenance",
            "label": "Provenance et traçabilité",
            "maxscore": 25,
            "required": true
          },
          {
            "key": "reflection",
            "label": "Réflexion critique",
            "maxscore": 25,
            "required": true
          }
        ],
        "ethical_constraints": [
          "Aucune humiliation publique.",
          "Aucune automatisation de décision par IA.",
          "Aucune preuve non sourcée comme fait établi."
        ],
        "badges": [
          "UCKK-BADGE-TC-COMPLETION"
        ],
        "competencies": [
          "UCKK-COMP-TC101",
          "UCKK-COMP-TC107",
          "UCKK-COMP-KOA204",
          "UCKK-COMP-IA104"
        ]
      },
      "sections": [
        "orientation",
        "preuves",
        "evaluation",
        "archive"
      ],
      "activities": [],
      "completion": {
        "requires_submission": true,
        "requires_review": true,
        "requires_archive": true
      },
      "metadata": {
        "seeded_by": "tool_uckkseed",
        "template_family": "challenge",
        "primary_language": "fr"
      }
    },
    {
      "key": "public_pedagogical",
      "name": "Défi pédagogique public",
      "component": "mod_uckkchallenge",
      "description": "Template de défi pour production pédagogique visible, théâtre public responsable et preuve archivable.",
      "defaults": {
        "challenge_type": "public_pedagogical",
        "status": "draft",
        "visibility": "public",
        "provenance": "system",
        "validationstate": "unverified",
        "requires_human_validation": true,
        "allow_ai_assistance": true,
        "allow_ai_decision": false,
        "archive_required": true,
        "integrity_review_required": true,
        "estimated_duration": "3 weeks",
        "participant_roles": [
          "uckkplayer",
          "uckkmentor",
          "uckkinquisitor"
        ],
        "statement": "Produire une intervention pédagogique publique, utile, contestable et non abusive.",
        "context": "Défi public UCKK avec responsabilité de dignité, clarté et provenance.",
        "rules": [
          "Le spectacle est permis; l’abus ne l’est pas.",
          "La cible pédagogique doit être claire.",
          "Les personnes concernées doivent être protégées.",
          "La publication finale exige une validation humaine."
        ],
        "corridors_of_action": [
          "préparation",
          "publication contrôlée",
          "réponse",
          "archive"
        ],
        "evidence_requirements": [
          {
            "type": "text",
