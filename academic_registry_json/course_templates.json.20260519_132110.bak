  "items": [
    {
      "key": "uckk_standard_course",
      "name": "UCKK standard course",
      "component": "format_uckk",
      "description": "Default UCKK course structure using the canonical nine-section format.",
      "defaults": {
        "format": "uckk",
        "numsections": 9,
        "visible": true,
        "lang": "fr",
        "courseformatoptions": {
          "uckkmode": "standard",
          "showcanon": 1,
          "showevidenceflow": 1,
          "showintegritynotice": 1,
          "showrecognitionnotice": 1
        }
      },
      "sections": [
        {
          "number": 0,
          "key": "orientation",
          "name": "Orientation",
          "summary": "Cadre du cours, règles du jeu pédagogique, objectifs et parcours attendu.",
          "options": {
            "uckksectionkind": "orientation",
            "requiresproof": 0,
            "archivable": 0,
            "integritysensitive": 0
          }
        },
        {
          "number": 1,
          "key": "concepts",
          "name": "Concepts",
          "summary": "Mots, modèles, distinctions et cartes conceptuelles à maîtriser.",
          "options": {
            "uckksectionkind": "concepts",
            "requiresproof": 0,
            "archivable": 0,
            "integritysensitive": 0
          }
        },
        {
          "number": 2,
          "key": "canon",
          "name": "Matière canonique",
          "summary": "Textes, références, documents, ressources et canon du cours.",
          "options": {
            "uckksectionkind": "canon",
            "requiresproof": 0,
            "archivable": 1,
            "integritysensitive": 0
          }
        },
        {
          "number": 3,
          "key": "atelier",
          "name": "Atelier",
          "summary": "Exercices, simulations, cartographies, analyses et travaux préparatoires.",
          "options": {
            "uckksectionkind": "atelier",
            "requiresproof": 0,
            "archivable": 1,
            "integritysensitive": 0
          }
        },
        {
          "number": 4,
          "key": "preuves",
          "name": "Preuves",
          "summary": "Production, dépôt, discussion et validation des preuves pédagogiques.",
          "options": {
            "uckksectionkind": "preuves",
            "requiresproof": 1,
            "archivable": 1,
            "integritysensitive": 1
          }
        },
        {
          "number": 5,
          "key": "deliberation",
          "name": "Délibération",
          "summary": "Discussion structurée, assemblée, objections, interprétations et décisions collectives.",
          "options": {
            "uckksectionkind": "deliberation",
            "requiresproof": 0,
            "archivable": 1,
            "integritysensitive": 1
          }
        },
        {
          "number": 6,
          "key": "livrable",
          "name": "Livrable",
          "summary": "Production finale, artefact, dossier, carte, rapport, stratégie ou prototype.",
          "options": {
            "uckksectionkind": "livrable",
            "requiresproof": 1,
            "archivable": 1,
            "integritysensitive": 0
          }
        },
        {
          "number": 7,
          "key": "evaluation",
          "name": "Évaluation",
          "summary": "Critères, rétroactions, compétences, badges et décisions pédagogiques.",
          "options": {
            "uckksectionkind": "evaluation",
            "requiresproof": 0,
            "archivable": 1,
            "integritysensitive": 1
          }
        },
        {
          "number": 8,
          "key": "archive",
          "name": "Archive",
          "summary": "Mémoire du cours : preuves, décisions, versions, corrections, Kristals et traces réutilisables.",
          "options": {
            "uckksectionkind": "archive",
            "requiresproof": 0,
            "archivable": 1,
            "integritysensitive": 1
          }
        }
      ],
      "activities": [
        {
          "key": "default_archive",
          "component": "mod_uckkarchive",
          "section": "archive",
          "name": "Archive du cours",
          "intro": "Mémoire du cours : preuves, décisions, versions, corrections, Kristals et traces réutilisables.",
          "required": true,
          "defaults": {
            "status": "active",
            "visibility": "course",
            "completionadditem": 1,
            "completionvalidateitem": 0
          }
        }
      ],
      "completion": {
        "enabled": true,
        "completionview": true,
        "requires_evidence": true,
        "requires_human_validation": true,
        "requires_archive_trace": true
      },
      "metadata": {
        "product": "UCKK-Moodle",
        "course_type": "standard",
        "recognition": "internal",
        "source": "tool_uckkseed"
      }
    },
