{
  "schema": "uckk.presets.course_templates.v1",
  "idempotency": "template.key",
  "default_format": "format_uckk",
  "defaults": {
    "visible": true,
    "completion_enabled": true,
    "activity_completion_enabled": true,
    "manual_completion_override_roles": [
      "mentor_uckk",
      "gestionnaire_uckk"
    ],
    "language_policy": {
      "primary": "fr",
      "secondary": "en"
    },
    "archive_required_on_completion": true
  },
  "sections": [
    {
      "key": "orientation",
      "number": 0,
      "name": "Orientation",
      "purpose": "Course entry, rules, expectations",
      "typical_components": [
        "page",
        "book",
        "label"
      ],
      "completion_marker": "viewed_orientation"
    },
    {
      "key": "concepts",
      "number": 1,
      "name": "Concepts",
      "purpose": "Key concepts and definitions",
      "typical_components": [
        "page",
        "glossary",
        "book"
      ],
      "completion_marker": "completed_concept_checks"
    },
    {
      "key": "matiere_canonique",
      "number": 2,
      "name": "Matière canonique",
      "purpose": "Core reading and source material",
      "typical_components": [
        "file",
        "page",
        "url",
        "book"
      ],
      "completion_marker": "viewed_canonical_material"
    },
    {
      "key": "atelier",
      "number": 3,
      "name": "Atelier",
      "purpose": "Active learning",
      "typical_components": [
        "forum",
        "workshop",
        "assign"
      ],
      "completion_marker": "completed_workshop_activity"
    },
    {
      "key": "preuves",
      "number": 4,
      "name": "Preuves",
      "purpose": "Evidence production",
      "typical_components": [
        "assign",
        "database",
        "uckkchallenge"
      ],
      "completion_marker": "submitted_evidence"
    },
    {
      "key": "deliberation",
      "number": 5,
      "name": "Délibération",
      "purpose": "Collective interpretation",
      "typical_components": [
        "forum",
        "uckkassembly"
      ],
      "completion_marker": "participated_in_deliberation"
    },
    {
      "key": "livrable",
      "number": 6,
      "name": "Livrable",
      "purpose": "Final deliverable",
      "typical_components": [
        "assign",
        "uckkchallenge_submission"
      ],
      "completion_marker": "submitted_final_deliverable"
    },
    {
      "key": "evaluation",
      "number": 7,
      "name": "Évaluation",
      "purpose": "Grading and feedback",
      "typical_components": [
        "gradebook",
        "rubric"
      ],
      "completion_marker": "received_evaluation"
    },
    {
      "key": "archive",
      "number": 8,
      "name": "Archive",
      "purpose": "Final memory",
      "typical_components": [
        "uckkarchive"
      ],
      "completion_marker": "archived_final_artifact"
    }
  ],
  "templates": [
    {
      "key": "uckk_standard_course",
      "name": "UCKK standard course",
      "description": "Default UCKK course template for ordinary tronc commun and pathway courses.",
      "format": "uckk",
      "completion_enabled": true,
      "activity_completion_enabled": true,
      "manual_completion_override_roles": [
        "mentor_uckk",
        "gestionnaire_uckk"
      ],
      "section_keys": [
        "orientation",
        "concepts",
        "matiere_canonique",
        "atelier",
        "preuves",
        "deliberation",
        "livrable",
        "evaluation",
        "archive"
      ],
      "completion_categories": [
        "viewed_orientation",
        "completed_concept_checks",
        "viewed_canonical_material",
        "completed_workshop_activity",
        "submitted_evidence",
        "participated_in_deliberation",
        "submitted_final_deliverable",
        "received_evaluation",
        "archived_final_artifact"
