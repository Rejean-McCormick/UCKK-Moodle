          "name": "Assemblée des savoirs",
          "required": true
        },
        {
          "section": "archive",
          "module": "uckkarchive",
          "template": "archive_course_memory",
          "name": "Archive du cours",
          "required": true
        }
      ],
      "evidence_policy": {
        "requires_proof": true,
        "requires_human_validation": true,
        "requires_archive_link": true,
        "allows_ai_assistance": true,
        "ai_output_is_final_authority": false
