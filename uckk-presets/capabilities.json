  "constraints": [
    {
      "rule": "symbolic_titles_are_not_roles",
      "description": "Bâtisseur, Joueur lucide, Cartographe de systèmes, Architecte du sens, Architecte d’opportunités, Gardien des systèmes vivants and Gardien de la preuve must be represented through badges, profile fields, cohorts, competencies, portfolios or archive distinctions, not Moodle roles."
    },
    {
      "rule": "inquisiteur_is_not_super_admin",
      "description": "Inquisiteur UCKK can review, pause, correct and invalidate integrity-sensitive objects, but cannot silently delete evidence, rewrite archive history, or assign unrestricted administration rights."
    },
    {
      "rule": "restricted_archive_requires_capability",
      "description": "Archive items with restricted_integrity visibility require mod/uckkarchive:viewrestricted or an equivalent higher administrative permission."
    },
    {
      "rule": "ai_is_non_sovereign",
      "description": "AI capabilities permit assistive use and log review only. AI cannot grade, close integrity cases, publish assembly decisions, validate archive items, award badges, certify competencies or erase evidence."
    }
  ]
